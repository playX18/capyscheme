;; Generates pkgs/core/src/core/compiler/bytecode/isa.scm, the instruction set of the runtime
;; as a Scheme library, from the primitive `%bytecode-isa` (crates/capy/src/bytecode/def.rs).
;;
;;   capy -s tools/gen-isa.scm [output-file]
;;
;; Run it with a runtime that has the instruction set you want to compile for (the stage that
;; builds the compiler), and commit the result. 
;;
;; The shape of the data is documented at `bytecode_isa` in
;; crates/capy/src/runtime/vm/load/boundary.rs and in docs/BYTECODE.md ("Encoding").

(import (rnrs) (only (capy) %bytecode-isa))

(define default-output "pkgs/core/src/core/compiler/bytecode/isa.scm")

(define isa (%bytecode-isa))

(define (field name)
  (let ((entry (assq name isa)))
    (unless entry (error 'gen-isa "missing field in %bytecode-isa" name))
    (cdr entry)))

(define (emit-list port items)
  ;; One element per line, quoted data.
  (for-each (lambda (item)
              (display "    " port)
              (write item port)
              (newline port))
            items))

(define (generate port)
  (define (line . parts)
    (for-each (lambda (part) (display part port)) parts)
    (newline port))
  (line ";; Generated by tools/gen-isa.scm from `%bytecode-isa`. Do not edit.")
  (line ";;")
  (line ";; The instruction set of crates/capy/src/bytecode/def.rs. The encoding is documented in")
  (line ";; docs/BYTECODE.md (\"Encoding (for the Scheme assembler)\").")
  (line ";;")
  (line ";; An opcode is `(name number operands metadata)`:")
  (line ";;   operands  list of `(name kind)` or `(name kind relative-start)` (a jump offset)")
  (line ";;   metadata  #f, or `(kind-index (field . type) ...)`: the instruction then ends with")
  (line ";;             a metadata id operand")
  (line ";; `isa-operand-kinds` maps an operand kind to its type, `u32` or `i32`.")
  (line)
  (line "(library (core compiler bytecode isa)")
  (line "  (export bytecode-isa isa-format-hash isa-num-metadata-kinds isa-wide16-prefix")
  (line "          isa-wide32-prefix isa-first-opcode isa-operand-kinds isa-opcodes isa-metadata-kinds")
  (line "          isa-opcode-ref isa-opcode-number isa-opcode-operands isa-opcode-metadata")
  (line "          isa-operand-type isa-operand-signed? isa-opcode-name)")
  (line "  (import (core) (capy))")
  (line)
  (line "  (define isa-format-hash " (field 'format-hash) ")")
  (line "  (define isa-num-metadata-kinds " (field 'num-metadata-kinds) ")")
  (line "  (define isa-wide16-prefix " (field 'wide16-prefix) ")")
  (line "  (define isa-wide32-prefix " (field 'wide32-prefix) ")")
  (line "  (define isa-first-opcode " (field 'first-opcode) ")")
  (line)
  (line "  ;; (kind type)")
  (line "  (define isa-operand-kinds")
  (line "    '(")
  (emit-list port (field 'operand-kinds))
  (line "    ))")
  (line)
  (line "  ;; (name number operands metadata), in opcode number order")
  (line "  (define isa-opcodes")
  (line "    '(")
  (emit-list port (field 'opcodes))
  (line "    ))")
  (line)
  (line "  ;; (kind-index opcode-name record-type-name field ...)")
  (line "  (define isa-metadata-kinds")
  (line "    '(")
  (emit-list port (field 'metadata-kinds))
  (line "    ))")
  (line)
  (line "  (define bytecode-isa")
  (line "    (list (cons 'format-hash isa-format-hash)")
  (line "          (cons 'num-metadata-kinds isa-num-metadata-kinds)")
  (line "          (cons 'wide16-prefix isa-wide16-prefix)")
  (line "          (cons 'wide32-prefix isa-wide32-prefix)")
  (line "          (cons 'first-opcode isa-first-opcode)")
  (line "          (cons 'operand-kinds isa-operand-kinds)")
  (line "          (cons 'opcodes isa-opcodes)")
  (line "          (cons 'metadata-kinds isa-metadata-kinds)))")
  (line)
  (line "  (define by-name")
  (line "    (let ((table (make-eq-hashtable)))")
  (line "      (for-each (lambda (opcode) (hashtable-set! table (car opcode) opcode)) isa-opcodes)")
  (line "      table))")
  (line)
  (line "  (define by-number")
  (line "    (let ((table (make-eqv-hashtable)))")
  (line "      (for-each (lambda (opcode) (hashtable-set! table (cadr opcode) opcode)) isa-opcodes)")
  (line "      table))")
  (line)
  (line "  ;; The opcode entry named NAME (a symbol), or #f.")
  (line "  (define (isa-opcode-ref name) (hashtable-ref by-name name #f))")
  (line)
  (line "  (define (opcode-entry name)")
  (line "    (or (hashtable-ref by-name name #f)")
  (line "        (assertion-violation 'isa-opcode-ref \"unknown opcode\" name)))")
  (line)
  (line "  ;; The number of the opcode NAME.")
  (line "  (define (isa-opcode-number name) (cadr (opcode-entry name)))")
  (line "  ;; The operands `(name kind [relative-start])` of the opcode NAME.")
  (line "  (define (isa-opcode-operands name) (caddr (opcode-entry name)))")
  (line "  ;; `#f` or `(kind-index (field . type) ...)` of the opcode NAME.")
  (line "  (define (isa-opcode-metadata name) (cadddr (opcode-entry name)))")
  (line "  ;; The name of the opcode numbered NUMBER, or #f.")
  (line "  (define (isa-opcode-name number)")
  (line "    (let ((opcode (hashtable-ref by-number number #f)))")
  (line "      (and opcode (car opcode))))")
  (line)
  (line "  ;; `u32` or `i32`, the type of an operand kind such as `register`.")
  (line "  (define (isa-operand-type kind)")
  (line "    (let ((entry (assq kind isa-operand-kinds)))")
  (line "      (if entry")
  (line "          (cadr entry)")
  (line "          (assertion-violation 'isa-operand-type \"unknown operand kind\" kind))))")
  (line)
  (line "  (define (isa-operand-signed? kind) (eq? (isa-operand-type kind) 'i32))")
  (line ")"))

(let* ((args (command-line))
       (output (if (> (length args) 1) (cadr args) default-output)))
  (when (file-exists? output) (delete-file output))
  (call-with-output-file output generate)
  (display "wrote ")
  (display output)
  (newline))
