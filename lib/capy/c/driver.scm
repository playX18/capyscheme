;; Cache and orchestration for (c-include ...).
(library (capy c driver)
  (export c-include-library c-cache-directory c-use-cache-directory! c-native-available?
    c-include-report)
  (import (rnrs) (capy) (capy crypto sha256) (core io process) (capy c gen))


  ;; Diagnostics of the most recent generation, as (HEADER KIND NAME WHY) entries
  (define last-diagnostics '())

  (define (hex bv)
    (let ([digits "0123456789abcdef"]
          [out (make-string (* 2 (bytevector-length bv)))])
      (do ([i 0 (+ i 1)]) ((= i (bytevector-length bv)) out)
        (let ([b (bytevector-u8-ref bv i)])
          (string-set! out (* 2 i) (string-ref digits (div b 16)))
          (string-set! out (+ 1 (* 2 i)) (string-ref digits (mod b 16)))))))

  (define (sha256-hex s) (hex (sha256 (string->utf8 s))))

  (define (datum->string d)
    (call-with-string-output-port (lambda (p) (write d p))))

  (define (string->datum s)
    (read (open-string-input-port s)))

  (define (split-on s ch)
    (let loop ([i 0] [start 0] [acc '()])
      (cond
        [(= i (string-length s)) (reverse (cons (substring s start i) acc))]
        [(char=? (string-ref s i) ch) (loop (+ i 1) (+ i 1) (cons (substring s start i) acc))]
        [else (loop (+ i 1) start acc)])))

  (define (join strings sep)
    (if (null? strings)
      ""
      (fold-left (lambda (acc s) (string-append acc sep s)) (car strings) (cdr strings))))

  (define (ensure-directory path)
    (let loop ([parts (split-on path #\/)] [prefix ""])
      (unless (null? parts)
        (let ([next (if (string=? prefix "") (car parts) (string-append prefix "/" (car parts)))])
          (when (and (> (string-length next) 0) (not (file-exists? next)))
            (guard (e [(file-exists? next) #t]) (create-directory next)))
          (loop (cdr parts) (if (and (string=? prefix "") (string=? (car parts) "")) "/" next))))))

  (define (read-file path)
    (call-with-input-file path (lambda (p) (get-string-all p))))

  (define (write-file-atomically path writer)
    (let ([tmp (string-append path ".tmp-" (number->string (microsecond)) "-" (make-uuid))])
      (call-with-output-file tmp writer)
      (rename-file tmp path)))

  (define (c-cache-directory)
    (or (getenv "CAPY_FFI_CACHE")
        (let ([xdg (getenv "XDG_CACHE_HOME")])
          (and xdg (string-append xdg "/capy/ffi")))
        (string-append (or (getenv "HOME") ".") "/.cache/capy/ffi")))

  (define host-os
    (cond-expand (macos "macos") (linux "linux") (windows "windows") (else "unknown")))

  (define (library-directory-name libsha)
    (string-append "ffi-autogenerated-" libsha "-" host-os "-" (host-arch)))

  ;; "sys/socket.h" -> ("sys" "socket"); "stdio.h" -> ("stdio")
  (define (header-segments header)
    (let* ([parts (filter (lambda (s) (> (string-length s) 0)) (split-on header #\/))]
           [last (car (reverse parts))]
           [stem (let loop ([i (- (string-length last) 1)])
                   (cond [(< i 0) last]
                         [(char=? (string-ref last i) #\.) (substring last 0 i)]
                         [else (loop (- i 1))]))])
      (append (reverse (cdr (reverse parts))) (list stem))))

  (define (library-file cache libsha segments)
    (string-append cache "/" (library-directory-name libsha) "/" (join segments "/") ".scm"))

  ;; Package-manager prefixes the system compiler does not search on its own.
  (define extra-include-directories
    '("/opt/homebrew/include" "/opt/local/include" "/usr/local/include"))

  (define (existing-directories dirs)
    (filter (lambda (d) (and (file-exists? d) (file-directory? d))) dirs))

  ;; The user's configuration with the default include directories appended
  (define (effective-config config)
    (let ([dirs (assq-ref* 'include-dirs config '())])
      (cons (cons 'include-dirs
              (append dirs (filter (lambda (d) (not (member d dirs)))
                             (existing-directories extra-include-directories))))
        (filter (lambda (o) (not (eq? (car o) 'include-dirs))) config))))

  (define (config-append config key values)
    (let ([old (assq-ref* key config '())])
      (cons (cons key (append old values))
        (filter (lambda (o) (not (eq? (car o) key))) config))))

  (define (prefix? p s)
    (and (<= (string-length p) (string-length s))
         (string=? p (substring s 0 (string-length p)))))

  ;; Framework path for macOS
  (define (framework-path n)
    (string-append "/System/Library/Frameworks/" n ".framework/" n))

  ;; #:frameworks '("CoreFoundation") -> the framework's binary, opened at run time by path.
  ;; Shims are compiled with `-framework NAME` instead (build-shim!).
  (define (framework-links config)
    (let ([names (assq-ref* 'frameworks config '())])
      (cond
        [(null? names) config]
        [(not (string=? host-os "macos"))
          (error 'c-include "#:frameworks only applies on macOS" names)]
        [else
          (config-append config 'link (map framework-path names))])))

  (define (valid-package-name? s)
    (and (> (string-length s) 0)
         (for-all
           (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (memv c '(#\- #\. #\_ #\+))))
           (string->list s))))

  (define (words s)
    (let loop ([cs (string->list s)] [cur '()] [acc '()])
      (define (flush) (if (null? cur) acc (cons (list->string (reverse cur)) acc)))
      (cond
        [(null? cs) (reverse (flush))]
        [(char-whitespace? (car cs)) (loop (cdr cs) '() (flush))]
        [else (loop (cdr cs) (cons (car cs) cur) acc)])))

  ;; Runs `pkg-config --cflags --libs NAME` and returns its output.
  (define (pkg-config-output name)
    (unless (valid-package-name? name)
      (error 'c-include "invalid pkg-config package name" name))
    (let* ([ports (open-process-ports (string-append "pkg-config --cflags --libs " name))]
           [out (car ports)]
           [err (caddr ports)]
           [pid (cadddr ports)]
           [text (get-string-all out)]
           [errors (get-string-all err)]
           [status (process-wait pid)])
      (close-port out)
      (close-port err)
      (unless (eqv? status 0)
        (if (eqv? status 127)
          (error 'c-include "pkg-config is not installed (needed for #:pkg-config)" name)
          (error 'c-include (string-append "pkg-config failed: " errors) name)))
      text))

  ;; #:pkg-config NAME adds the include directories, libraries, macros and frameworks that
  ;; pkg-config reports for NAME. A -lNAME is linked from the -L directories when a file
  ;; is there, else by name.
  (define (pkg-config-expansion config)
    (let ([name (assq-ref* 'pkg-config config #f)])
      (if (not name)
        config
        (let* ([ws (words (pkg-config-output name))]
               [libdirs (let loop ([ws ws] [acc '()])
                          (cond [(null? ws) (reverse acc)]
                                [(prefix? "-L" (car ws))
                                  (loop (cdr ws) (cons (substring (car ws) 2 (string-length (car ws))) acc))]
                                [else (loop (cdr ws) acc)]))]
               [find-lib (lambda (l)
                           (or (let loop ([dirs libdirs])
                                 (cond
                                   [(null? dirs) #f]
                                   [(find file-exists?
                                      (map (lambda (ext) (string-append (car dirs) "/lib" l ext))
                                        '(".dylib" ".so" ".a")))
                                     => values]
                                   [else (loop (cdr dirs))]))
                             l))]
               [includes '()] [links '()] [defines '()] [frameworks '()])
          (let loop ([ws ws])
            (cond
              [(null? ws) #t]
              [(prefix? "-I" (car ws))
                (set! includes (cons (substring (car ws) 2 (string-length (car ws))) includes))
                (loop (cdr ws))]
              [(prefix? "-l" (car ws))
                (set! links (cons (find-lib (substring (car ws) 2 (string-length (car ws)))) links))
                (loop (cdr ws))]
              [(prefix? "-D" (car ws))
                (let* ([body (substring (car ws) 2 (string-length (car ws)))]
                       [equals (let scan ([i 0])
                             (cond [(= i (string-length body)) #f]
                                   [(char=? (string-ref body i) #\=) i]
                                   [else (scan (+ i 1))]))])
                  (set! defines
                    (cons (if equals
                            (cons (substring body 0 equals) (substring body (+ equals 1) (string-length body)))
                            body)
                      defines)))
                (loop (cdr ws))]
              [(and (string=? (car ws) "-framework") (pair? (cdr ws)))
                (set! frameworks (cons (cadr ws) frameworks))
                (loop (cddr ws))]
              [else (loop (cdr ws))]))
          (let* ([config (config-append config 'include-dirs (reverse includes))]
                 [config (config-append config 'link (reverse links))]
                 [config (config-append config 'defines (reverse defines))]
                 [config (config-append config 'frameworks (reverse frameworks))])
            config)))))

  ;; Frameworks are turned into links last, so the ones pkg-config names are included.
  (define (expand-config config)
    (framework-links (pkg-config-expansion config)))

  ;; <prefix>/include/foo.h usually goes with <prefix>/lib/libfoo.{dylib,so}.
  (define (sibling-libraries header-path header)
    (let* ([segments (header-segments header)]
           [stem (car (reverse segments))]
           [include-dir (let loop ([path header-path] [n (length segments)])
                          (if (= n 0) path (loop (dirname* path) (- n 1))))]
           [lib-dir (string-append (dirname* include-dir) "/lib")])
      (filter file-exists?
        (map (lambda (ext) (string-append lib-dir "/lib" stem ext))
          '(".dylib" ".so")))))

  (define (dirname* path)
    (let loop ([i (- (string-length path) 1)])
      (cond [(< i 0) "."]
            [(char=? (string-ref path i) #\/) (substring path 0 i)]
            [else (loop (- i 1))])))

  (define key-environment
    '("CC" "CAPY_CC" "SDKROOT" "CPATH" "C_INCLUDE_PATH" "CPLUS_INCLUDE_PATH" "DEVELOPER_DIR"))

  (define (sort-config config)
    (list-sort (lambda (a b) (string<? (symbol->string (car a)) (symbol->string (car b)))) config))

  (define (request-key header config)
    (sha256-hex
      (datum->string
        (list host-os (host-arch) header (sort-config config)
          (map (lambda (name) (cons name (getenv name))) key-environment)))))

  ;; ---- static inline shims ------------------------------------------------------------

  (define (shim-extension) (cond-expand (macos "dylib") (else "so")))

  (define (shell-quote s)
    (call-with-string-output-port
      (lambda (p)
        (write-char #\' p)
        (for-each (lambda (c) (if (char=? c #\') (display "'\\''" p) (write-char c p))) (string->list s))
        (write-char #\' p))))

  (define (path-like? s) (exists (lambda (c) (char=? c #\/)) (string->list s)))

  (define (run-shell command)
    (let* ([ports (open-process-ports (string-append command " 2>&1"))]
           [out (car ports)]
           [pid (cadddr ports)]
           [text (get-string-all out)]
           [status (process-wait pid)])
      (close-port out)
      (close-port (cadr ports))
      (close-port (caddr ports))
      (values status text)))

  ;; Compiles the shim source of UNIT (its `(shim SOURCE NAMES)` entry) into a shared
  ;; library in the cache, with the request's include directories, defines, standard and
  ;; libraries. Returns (values LIBRARY-PATH #f), or (values #f COMPILER-OUTPUT) on failure,
  ;; or (values #f #f) when there is nothing to build.
  (define (shim-cc config)
    (or (assq-ref* 'cc config #f) (getenv "CAPY_CC") (getenv "CC") "cc"))

  (define (shim-source-file cache reqsha)
    (string-append cache "/shims/shim-" reqsha ".c"))

  ;; The source text of UNIT's shim, or #f when the unit has no shim to build.
  (define (shim-source-text unit)
    (let ([entry (find (lambda (x) (eq? (car x) 'shim)) (cdr unit))])
      (and entry (pair? (caddr entry)) (cadr entry))))

  ;; The compiler file the shim build would run (path, mtime, size), or #f when not found.
  (define (executable-stat cc)
    (let ([path (if (path-like? cc)
                  cc
                  (find file-exists?
                    (map (lambda (d) (string-append d "/" cc))
                      (filter (lambda (d) (> (string-length d) 0))
                        (split-on (or (getenv "PATH") "") #\:)))))])
      (and path (stat-of path))))

  (define (shim-build-state config source-sha)
    (let ([cc (shim-cc config)])
      (list cc (executable-stat cc)
        (map (lambda (name) (cons name (getenv name))) key-environment)
        source-sha)))

  ;; Compiles the shim source of UNIT (its `(shim SOURCE NAMES)` entry) into a shared
  ;; library in the cache, with the request's include directories, defines, standard and
  ;; libraries. Frameworks are passed as `-framework NAME`, never as their binary's path.
  ;; Returns (values LIBRARY-PATH #f), or (values #f COMPILER-OUTPUT) on failure,
  ;; or (values #f #f) when there is nothing to build.
  (define (build-shim! cache reqsha unit config)
    (let ([source (shim-source-text unit)])
      (if (not source)
        (values #f #f)
        (let* ([dir (string-append cache "/shims")]
               [src (shim-source-file cache reqsha)]
               [lib (string-append dir "/libcapyshim-" reqsha "." (shim-extension))]
               [frameworks (assq-ref* 'frameworks config '())]
               [framework-paths (map framework-path frameworks)]
               [words
                 (append
                   (list (shim-cc config) "-shared" "-fPIC" "-O1")
                   (let ([std (assq-ref* 'std config #f)]) (if std (list (string-append "-std=" std)) '()))
                   (map (lambda (d) (string-append "-I" d)) (assq-ref* 'include-dirs config '()))
                   (map (lambda (d)
                          (if (pair? d) (string-append "-D" (car d) "=" (cdr d)) (string-append "-D" d)))
                     (assq-ref* 'defines config '()))
                   (append-map (lambda (f) (list "-framework" f)) frameworks)
                   (map (lambda (l) (if (path-like? l) l (string-append "-l" l)))
                     (filter (lambda (l) (not (member l framework-paths)))
                       (assq-ref* 'link config '())))
                   (cond-expand (macos (list "-Wl,-undefined,dynamic_lookup")) (else '()))
                   (list "-o" lib src))])
          (ensure-directory dir)
          (write-file-atomically src (lambda (p) (display source p)))
          (let-values ([(status output)
                        (run-shell (join (map shell-quote words) " "))])
            (if (eqv? status 0)
              (values lib #f)
              (values #f output)))))))

  (define (manifest-path cache reqsha)
    (string-append cache "/requests/" reqsha ".scm"))

  (define (stat-of path)
    (guard (e [#t #f])
      (list path (file-stat-mtime path) (file-size-in-bytes path))))

  (define (deps-unchanged? deps)
    (for-all (lambda (d) (equal? (stat-of (car d)) d)) deps))

  ;; Manifest: (manifest LIBSHA DEPS SHIM BUILD). BUILD is #f when the unit has no shim,
  ;; else (build STATE OUTPUT): STATE is shim-build-state at the time of the build and
  ;; OUTPUT the compiler's message when it failed (#f on success). Manifests of an older
  ;; layout have four fields and are regenerated.
  ;;
  ;; Returns (LIBSHA FAILURE) when the manifest for REQSHA is still valid, FAILURE being the
  ;; saved compiler message of a failed shim build or #f. A failed shim is retried, which
  ;; means regenerating, when the compiler or its environment or the shim source changed.
  ;; Returns #f otherwise.
  (define (lookup-manifest cache config reqsha segments)
    (let ([path (manifest-path cache reqsha)])
      (and (file-exists? path)
           (guard (e [#t #f])
             (let ([m (string->datum (read-file path))])
               (and (pair? m) (eq? (car m) 'manifest) (= (length m) 5)
                    (deps-unchanged? (caddr m))
                    (let ([shim (cadddr m)]) (or (not (string? shim)) (file-exists? shim)))
                    (file-exists? (library-file cache (cadr m) segments))
                    (let ([build (list-ref m 4)])
                      (cond
                        [(not build) (list (cadr m) #f)]
                        [(not (eq? (car build) 'build)) #f]
                        [(equal? (cadr build)
                           (shim-build-state config
                             (sha256-hex (read-file (shim-source-file cache reqsha)))))
                         (list (cadr m) (caddr build))]
                        [(caddr build) #f]
                        [else (list (cadr m) #f)]))))))))


  (define (native-library-names)
    (let ([stem (cond-expand (macos "libcapy_cparse.dylib") (else "libcapy_cparse.so"))])
      (append
        (let ([explicit (getenv "CAPY_CPARSE_LIB")]) (if explicit (list explicit) '()))
        (list (string-append %capy-root "/" stem)
          (string-append %capy-root "/lib/capy/" stem))
        (append-map
          (lambda (dir)
            (list (string-append dir "/../" stem)
              (string-append dir "/../target/release/" stem)
              (string-append dir "/../target/debug/" stem)))
          %load-path))))

  (define (c-native-available?)
    (and (find file-exists? (native-library-names)) #t))


  (define (native-procedure name)
    (unless (library-instance (current-library-registry) '(capy c native))
      (let ([found (find file-exists? (native-library-names))])
        (unless found
          (error 'c-include "cannot find the C parser library (set CAPY_CPARSE_LIB)"))
        (load-native-extension found)))
    (instance-ref (library-instance (current-library-registry) '(capy c native)) name))

  (define (parse-header header config)
    (let* ([request
             `((header ,header)
               (angle ,(not (assq-ref* 'quote-include config #f)))
               (include-dirs ,@(assq-ref* 'include-dirs config '()))
               (defines ,@(append
                            (map (lambda (d) (if (pair? d) (list (car d) (cdr d)) (list d #f)))
                              (assq-ref* 'defines config '()))))
               ,@(let ([std (assq-ref* 'std config #f)]) (if std `((std ,std)) '()))
               ,@(let ([cc (assq-ref* 'cc config #f)]) (if cc `((cc ,cc)) '()))
               (inline-bodies #t))]
           [result ((native-procedure 'c-process-header) request)])
      (unless (and (pair? result) (eq? (car result) 'c-result))
        (error 'c-include "the C parser returned an unexpected result" header))
      result))

  (define (assq-ref* key alist default)
    (let ([p (assq key alist)]) (if p (cdr p) default)))

  ;; ---- generation ---------------------------------------------------------------------

  (define (write-library port form)
    ;; (library NAME (export ...) (import ...) body ...), one form per line.
    (display "(library " port) (write (cadr form) port) (newline port)
    (for-each (lambda (f) (display "  " port) (write f port) (newline port)) (cddr form))
    (display ")" port) (newline port))

  (define (library-text form)
    (call-with-string-output-port (lambda (p) (write-library p form))))

  ;; The diagnostics of a generation are saved beside the manifest so a cache hit, in this
  ;; or a later process, reports the same skipped names. A shim failure is kept in the
  ;; manifest instead, so it is not saved here.
  (define (diagnostics-path cache reqsha)
    (string-append cache "/requests/" reqsha ".diag"))

  (define (save-diagnostics! cache reqsha header)
    (write-file-atomically (diagnostics-path cache reqsha)
      (lambda (p)
        (write (filter (lambda (d) (and (equal? (car d) header) (not (eq? (cadr d) 'shim-failed))))
                 last-diagnostics)
          p)
        (newline p))))

  (define (restore-diagnostics! cache reqsha header)
    (let ([saved (let ([path (diagnostics-path cache reqsha)])
                   (and (file-exists? path)
                     (guard (e [#t #f]) (string->datum (read-file path)))))])
      (when (list? saved)
        (set! last-diagnostics
          (append (filter (lambda (d) (not (equal? (car d) header))) last-diagnostics)
            saved)))))

  (define (report-diagnostics header result generation-report)
    (let ([errors (cadr (assq 'errors (cdr result)))])
      (set! last-diagnostics
        (append
          (if (> errors 0) (list (list header 'parse-errors errors #f)) '())
          (map (lambda (r) (cons header r)) generation-report)))
      (when (> errors 0)
        (format (current-error-port) ";; c-include ~a: ~a parse error~a (see (c-include-report))~%"
          header errors (if (= errors 1) "" "s")))
      (for-each
        (lambda (r)
          (when (eq? (car r) 'skipped)
            (format (current-error-port) ";; c-include ~a: skipped ~a: ~a~%" header (cadr r) (caddr r))))
        generation-report)))

  (define (remember-shim-failure! header output)
    (set! last-diagnostics
      (append
        (filter (lambda (d) (not (and (equal? (car d) header) (eq? (cadr d) 'shim-failed))))
          last-diagnostics)
        (list (list header 'shim-failed #f output)))))

  (define (generate! cache header config reqsha segments)
    (let* ([result (parse-header header config)]
           [unit (cadr (cdr (cdr result)))]
           [deps (cdr (assq 'deps (cdr result)))]
           [files (cdr (assq 'files (cdr unit)))]
           [source (shim-source-text unit)])
      (when (< (length files) 3)
        (error 'c-include "header not found" header))
      (let-values ([(shim-path shim-output) (build-shim! cache reqsha unit config)])
      (set! config
        (cons (cons 'link (append (assq-ref* 'link config '()) (sibling-libraries (caddr files) header)
                            (if shim-path (list shim-path) '())))
          (filter (lambda (o) (not (eq? (car o) 'link))) config)))
      ;; The library name embeds the hash of its own text, so it has to be generated twice:
      ;; once to hash, once with the name filled in.
      (let-values ([(draft report) (generate-library unit header config (list 'placeholder) shim-path)])
        (let* ([libsha (sha256-hex (library-text draft))]
               [name (cons (string->symbol (library-directory-name libsha)) (map string->symbol segments))])
          (let-values ([(form report) (generate-library unit header config name shim-path)])
            (let ([path (library-file cache libsha segments)])
              (ensure-directory (string-append cache "/requests"))
              (ensure-directory (let ([parts (reverse (split-on path #\/))]) (join (reverse (cdr parts)) "/")))
              (write-file-atomically path (lambda (p) (write-library p form)))
              (write-file-atomically (manifest-path cache reqsha)
                (lambda (p)
                  (write `(manifest ,libsha ,(filter values (map stat-of deps)) ,shim-path
                            ,(and source
                               `(build ,(shim-build-state config (sha256-hex source)) ,shim-output)))
                    p)
                  (newline p)))
              (report-diagnostics header result report)
              (when shim-output
                (remember-shim-failure! header shim-output)
                (format (current-error-port)
                  ";; c-include ~a: the C shim did not compile (see (c-include-report))~%" header))
              (save-diagnostics! cache reqsha header)
              libsha)))))))

  (define (c-use-cache-directory! dir)
    (unless (member dir %load-path)
      (set! %load-path (cons dir %load-path))))

  ;; Returns the library name `(ffi-autogenerated-... seg ...)` for HEADER under CONFIG,
  ;; generating it if needed, with the cache directory on `%load-path`.
  (define (c-include-report) last-diagnostics)

  (define (c-include-library header config)
    (let* ([config (effective-config (expand-config config))]
           [cache (c-cache-directory)]
           [segments (header-segments header)]
           [reqsha (request-key header config)]
           [cached (lookup-manifest cache config reqsha segments)]
           [libsha (if cached
                     (begin
                       (restore-diagnostics! cache reqsha header)
                       (when (cadr cached) (remember-shim-failure! header (cadr cached)))
                       (car cached))
                     (generate! cache header config reqsha segments))])
      (c-use-cache-directory! cache)
      (cons (string->symbol (library-directory-name libsha)) (map string->symbol segments))))

  (c-use-cache-directory! (c-cache-directory)))
