(define-record-type point (fields (mutable x) (mutable y) z))
(define-record-type (point3 make-point3 point3?) (parent point) (fields (mutable q) (immutable r)))
(define-record-type (sp make-sp sp?) (sealed #t) (fields (mutable a)))
(define-record-type (pp make-pp pp?) (fields a b) (protocol (lambda (n) (lambda (a b) (n a (+ b 1))))))
(define-record-type (pq make-pq pq?) (parent point) (protocol (lambda (n) (lambda (x w) ((n x x x) w)))) (fields (mutable w)))
(define-record-type empty (fields))
(define (show tag thunk)
  (display tag) (display " => ")
  (guard (e [#t (display (if (condition? e)
                           (list (if (who-condition? e) (condition-who e) 'nowho)
                                 (if (message-condition? e) (condition-message e) 'nomsg)
                                 (if (irritants-condition? e) (map (lambda (x) (if (record? x) 'rec x)) (condition-irritants e)) 'noirr))
                           e))])
    (write (thunk)))
  (newline))
(define p (make-point 1 2 3))
(define p3 (make-point3 1 2 3 4 5))
(show "ref" (lambda () (list (point-x p) (point-y p) (point-z p))))
(show "ref sub" (lambda () (list (point-x p3) (point3-q p3) (point3-r p3) (point-z p3))))
(show "mut" (lambda () (point-x-set! p 10) (point-x p)))
(show "mut sub" (lambda () (point-y-set! p3 20) (point3-q-set! p3 30) (list (point-y p3) (point3-q p3))))
(show "pred" (lambda () (list (point? p) (point? p3) (point3? p) (point3? p3) (point? 1) (point? '#(1)) (sp? (make-sp 1)) (sp? p) (empty? (make-empty)))))
(show "protocol" (lambda () (let ([x (make-pp 1 2)]) (list (pp-a x) (pp-b x)))))
(show "protocol parent" (lambda () (let ([x (make-pq 7 8)]) (list (point-x x) (point-z x) (pq-w x)))))
(show "ref nonrecord" (lambda () (point-x 5)))
(show "ref wrong type" (lambda () (point3-q p)))
(show "ref other record" (lambda () (point-x (make-sp 1))))
(show "ref vector" (lambda () (point-x (vector 1 2 3))))
(show "ref empty tuple" (lambda () (guard (e [#t (quote raised)]) (point-x (tuple)))))
(show "mut nonrecord" (lambda () (point-x-set! 5 1)))
(show "mut wrong type" (lambda () (point3-q-set! p 1)))
(show "ctor arity" (lambda () (make-point 1 2)))
(show "ctor arity sub" (lambda () (make-point3 1 2 3)))
(show "pp arity" (lambda () (make-pp 1)))
(show "record-accessor" (lambda () ((record-accessor (record-type-descriptor point) 1) p)))
(show "record-constructor" (lambda () (point-z ((record-constructor (record-type-rcd-of)) 1 2 3))))
(show "procedural" (lambda () (let* ([rtd (make-record-type-descriptor 'r #f #f #f #f '#((mutable a)))]
                                     [rcd (make-record-constructor-descriptor rtd #f #f)]
                                     [r ((record-constructor rcd) 5)])
                                (list ((record-accessor rtd 0) r) ((record-predicate rtd) r)))))
(show "map accessor" (lambda () (map point-x (list p p3))))
(show "record?" (lambda () (list (record? p) (record-rtd p))))
