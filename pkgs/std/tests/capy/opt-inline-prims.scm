(import (rnrs) (srfi 64) (only (capy) fx+/wraparound fx-/wraparound fx*/wraparound fxsll/wraparound fxsrl fxrotr32 fxrotl32))
;; Each check runs 20000 times, so the procedure reaches the optimizing
;; tier and its inline lowerings (and their deopts) are what is tested. The
;; first mismatch of every check is kept.
(test-begin "opt inline primitives")
(define failures '())
(define (check name got want)
  (unless (or (equal? got want) (assq name failures))
    (set! failures (cons (list name got want) failures))))
(define-syntax raises?
  (syntax-rules () [(_ e) (guard (c [#t #t]) e #f)]))

(define bv (u8-list->bytevector '(1 2 3 4 5 6 7 #xff #x80 0 0 #x80)))

(define (run i)
  (let ([x (fx- i 500)])
    (check 'fxand (fxand x #xf0) (bitwise-and x #xf0))
    (check 'fxior (fxior x 3) (bitwise-ior x 3))
    (check 'fxxor (fxxor x -1) (bitwise-xor x -1))
    (check 'fxnot (fxnot x) (- -1 x))
    (check 'fxashl (fxarithmetic-shift-left x 3) (* x 8))
    (check 'fxashr (fxarithmetic-shift-right x 2) (div x 4))
    (check 'fxmin (fxmin x 7) (min x 7))
    (check 'fxmax (fxmax x 7) (max x 7))
    (check 'fxodd (fxodd? x) (odd? x))
    (check 'fxeven (fxeven? x) (even? x))
    (check 'ashl-ovf (raises? (fxarithmetic-shift-left (greatest-fixnum) 1)) #t)
    (check 'fx+ovf (raises? (fx+ (greatest-fixnum) (fxand i 1) 1)) #t)
    (check 'fl+ (fl+ (fixnum->flonum x) 0.5) (+ x 0.5))
    (check 'fl< (fl<? (fixnum->flonum x) 0.0) (< x 0))
    (check 'flzero (flzero? (fixnum->flonum x)) (= x 0))
    (check 'flnan (flnan? (fl/ 0.0 0.0)) #t)
    (check 'flnan2 (flnan? 1.0) #f)
    (check 'flfloor (flfloor (fl/ (fixnum->flonum x) 3.0)) (floor (/ x 3.0)))
    (check 'flsqrt (flsqrt 16.0) 4.0)
    (check 'fl-type (raises? (fl+ 1 2.0)) #t)
    (check 'int->char (integer->char (fx+ 65 (fxand i 15))) (string-ref "ABCDEFGHIJKLMNOP" (fxand i 15)))
    (check 'int->char-max (char->integer (integer->char #x10FFFF)) #x10FFFF)
    (check 'int->char-surrogate (raises? (integer->char (fx+ #xD800 (fxand i 7)))) #t)
    (check 'int->char-neg (raises? (integer->char (fx- -1 (fxand i 1)))) #t)
    (check 'int->char-big (raises? (integer->char #x110000)) #t)
    (check 'logand (bitwise-and x (expt 2 40)) (if (< x 0) (expt 2 40) 0))
    (check 'logand-big (bitwise-and (+ (expt 2 70) x) #xff) (bitwise-and x #xff))
    (check 'bitwise-ior64 (bitwise-ior (expt 2 62) x) (bitwise-ior (expt 2 62) x))
    (check 'bitwise-not (bitwise-not x) (- -1 x))
    (check 'bw-shl (bitwise-arithmetic-shift-left x 20) (* x (expt 2 20)))
    (check 'bw-shl-ovf (bitwise-arithmetic-shift-left (+ (expt 2 60) x) 10) (* (+ (expt 2 60) x) 1024))
    (check 'bw-shr (bitwise-arithmetic-shift-right x 3) (div x 8))
    (check 'bw-shr64 (bitwise-arithmetic-shift-right (- (expt 2 63) 1) 62) 1)
    (check 'u32be (bytevector-u32-ref bv 4 (endianness big)) #x050607ff)
    (check 'u32le (bytevector-u32-ref bv 4 (endianness little)) #xff070605)
    (check 's32be (bytevector-s32-ref bv 8 (endianness big)) (- #x80000080 #x100000000))
    (check 'u16be (bytevector-u16-ref bv 7 (endianness big)) #xff80)
    (check 's16be (bytevector-s16-ref bv 7 (endianness big)) (- #xff80 #x10000))
    (check 's16le (bytevector-s16-ref bv 6 (endianness little)) (- #xff07 #x10000))
    (check 'u32-oob (raises? (bytevector-u32-ref bv (fx+ 9 (fxand i 1)) (endianness big))) #t)
    (check 'u32-neg (raises? (bytevector-u32-ref bv (fx- -1 (fxand i 1)) (endianness big))) #t)
    (check 's32native (bytevector-s32-native-ref bv 0) #x04030201)
    (check 's8native (bytevector-s8-ref bv 7) -1)
    (check 'u16native (bytevector-u16-native-ref bv 6) #xff07)
    (check 's16native (bytevector-s16-native-ref bv 7) (- #x80ff #x10000))
    (check 'native-oob (raises? (bytevector-s32-native-ref bv (fx+ 9 (fxand i 1)))) #t)
    (check 'wrap+ (fx+/wraparound (greatest-fixnum) (fx+ 1 (fxand i 0))) (least-fixnum))
    (check 'wrap- (fx-/wraparound (least-fixnum) 1) (greatest-fixnum))
    (check 'wrap* (fx*/wraparound #x10000 (fx+ #x10000 (fxand i 0))) 0)
    (check 'sll (fxsll/wraparound -1 31) (least-fixnum))
    (check 'srl (fxsrl -1 28) 15)
    (check 'srl1 (fxsrl x 1) (if (< x 0) (div (+ x (expt 2 32)) 2) (div x 2)))
    (check 'rotr (fxrotr32 1 1) (least-fixnum))
    (check 'rotr2 (fxrotr32 x 8) (let ([u (mod x (expt 2 32))]) (let ([r (mod (+ (div u 256) (* (mod u 256) (expt 2 24))) (expt 2 32))]) (if (>= r (expt 2 31)) (- r (expt 2 32)) r))))
    (check 'rotl (fxrotl32 (least-fixnum) 1) 1)
    (check 'srl-type (raises? (fxsrl 1.0 3)) #t)))

(do ([i 0 (+ i 1)]) ((= i 20000)) (run (mod i 1000)))
(test-equal "no mismatches" '() failures)
(test-end "opt inline primitives")
