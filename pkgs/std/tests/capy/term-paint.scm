(import (rnrs) (srfi 64) (capy term paint))

(test-begin "capy term paint")
(define always (make-painter 'always (current-output-port)))
(define never (make-painter 'never (current-output-port)))
(test-equal "always" "\x1b;[1;32mok\x1b;[0m" (paint always '(bold green) "ok"))
(test-equal "never" "ok" (paint never '(bold green) "ok"))
(test-equal "no styles" "ok" (paint always '() "ok"))
(test-assert "enabled?" (painter-enabled? always))
(test-assert "disabled" (not (painter-enabled? never)))
(test-equal "parse" 'auto (parse-color-mode "auto"))
(test-error "parse bad" (parse-color-mode "sometimes"))
(test-error "unknown style" (paint always '(sparkly) "x"))
(test-end)
