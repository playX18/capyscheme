(import (rnrs) (srfi 64) (capy path))

(test-begin "capy path")
(test-equal "join" "a/b/c" (path-join "a" "b" "c"))
(test-equal "join slash" "a/b" (path-join "a/" "b"))
(test-equal "join absolute" "/b" (path-join "a" "/b"))
(test-equal "directory" "a/b" (path-directory "a/b/c.scm"))
(test-equal "directory none" "." (path-directory "c.scm"))
(test-equal "directory root" "/" (path-directory "/c.scm"))
(test-equal "file name" "c.scm" (path-file-name "a/b/c.scm"))
(test-equal "components" '("a" "b") (path-components "/a//b/"))
(test-equal "relative" "../y/z" (path-relative "/x/y/z" "/x/w"))
(test-equal "relative inside" "y/z" (path-relative "/x/y/z" "/x"))
(test-equal "relative same" "." (path-relative "/x" "/x"))
(test-end)
