(import (rnrs)
  (srfi 64)
  (capy time)
  (capy time civil)
  (capy time tzif))

(test-begin "capy time")

(define (dt->list d)
  (list (datetime-year d) (datetime-month d) (datetime-day d) (datetime-hour d) (datetime-minute d)
        (datetime-second d) (datetime-nanosecond d) (datetime-offset d)))

(define (parse-error? thunk)
  (guard (e [(time-parse-error? e) #t] [#t (list 'other e)]) (thunk) #f))

(test-group "calendar"
  (test-equal "epoch day" 0 (civil->days 1970 1 1))
  (test-equal "2000-03-01" 11017 (civil->days 2000 3 1))
  (test-equal "round trip" '(2000 3 1) (call-with-values (lambda () (days->civil 11017)) list))
  (test-equal "before the epoch" '(1969 12 31) (call-with-values (lambda () (days->civil -1)) list))
  (test-equal "year 1" '(1 1 1) (call-with-values (lambda () (days->civil (civil->days 1 1 1))) list))
  (test-equal "negative year" '(-44 3 15) (call-with-values (lambda () (days->civil (civil->days -44 3 15))) list))
  (let loop ([z -800000] [ok #t])
    (if (> z 800000)
      (test-assert "every day round-trips" ok)
      (loop (+ z 997) (and ok (= z (call-with-values (lambda () (days->civil z)) civil->days))))))
  (test-assert "leap 2000" (leap-year? 2000))
  (test-assert "not leap 1900" (not (leap-year? 1900)))
  (test-assert "leap 2024" (leap-year? 2024))
  (test-equal "february" '(29 28) (list (days-in-month 2024 2) (days-in-month 2023 2)))
  (test-equal "thursday epoch" 4 (day-of-week 1970 1 1))
  (test-equal "2024-02-29 is a Thursday" 4 (day-of-week 2024 2 29))
  (test-equal "day of year" 366 (day-of-year 2024 12 31))
  (test-equal "names" '("Wednesday" "Wed" "March" "Mar")
    (list (weekday-name 3) (weekday-name 3 #:short? #t) (month-name 3) (month-name 3 #:short? #t)))
  ;; ISO weeks: 2021-01-03 is in week 53 of 2020; 2024-12-30 is in week 1 of 2025.
  (test-equal "iso week of 2021-01-03" '(2020 53 7)
    (call-with-values (lambda () (iso-week-date (civil->days 2021 1 3))) list))
  (test-equal "iso week of 2024-12-30" '(2025 1 1)
    (call-with-values (lambda () (iso-week-date (civil->days 2024 12 30))) list))
  (test-equal "iso week inverse" (civil->days 2020 12 31) (iso-week->days 2020 53 4)))

(test-group "durations"
  (test-equal "normalized" '(-2 500000000)
    (let ([d (make-duration -1 -500000000)]) (list (duration-seconds d) (duration-nanoseconds d))))
  (test-equal "keywords" (* 5400 1000000000) (duration->nanoseconds (duration #:hours 1 #:minutes 30)))
  (test-equal "fractional" 1500000 (duration->nanoseconds (duration #:milliseconds 1.5)))
  (test-equal "arithmetic" 3 (duration-seconds (duration+ (make-duration 1) (make-duration 2))))
  (test-equal "minus" -1 (duration-seconds (duration- (make-duration 1) (make-duration 2))))
  (test-equal "negate" '(-1 0) (let ([d (duration- (make-duration 1))]) (list (duration-seconds d) (duration-nanoseconds d))))
  (test-equal "scale" 750000000 (duration->nanoseconds (duration* (make-duration 0 500000000) 3/2)))
  (test-assert "compare" (duration<? (make-duration 1) (make-duration 1 1)))
  (test-assert "zero" (duration-zero? (duration- (make-duration 3) (make-duration 3))))
  (test-equal "seconds" 1.25 (duration->seconds (seconds->duration 1.25)))
  (test-equal "milliseconds" 1250 (duration->milliseconds (seconds->duration 1.25)))
  (test-equal "to string" '("0s" "1ns" "1.5us" "250ms" "1s" "1m30s" "1h0m0.5s" "-3s" "26h0m0s")
    (map duration->string
         (list zero-duration (make-duration 0 1) (make-duration 0 1500) (duration #:milliseconds 250)
               (make-duration 1) (make-duration 90) (make-duration 3600 500000000) (make-duration -3)
               (duration #:days 1 #:hours 2))))
  (test-equal "parse" (map duration->nanoseconds
                            (list (duration #:hours 1 #:minutes 30) (duration #:milliseconds 2500)
                                  (duration #:minutes -1) (duration #:microseconds 3) zero-duration
                                  (duration #:days 1 #:hours 12)))
    (map (lambda (s) (duration->nanoseconds (parse-duration s))) '("1h30m" "2.5s" "-1m" "3us" "0" "1d12h")))
  (test-assert "parse error" (parse-error? (lambda () (parse-duration "5 parsecs"))))
  (test-assert "string round trip"
    (duration=? (make-duration 3723 4000000) (parse-duration (duration->string (make-duration 3723 4000000))))))

(test-group "instants and clocks"
  (let ([t (make-instant 1700000000 123)])
    (test-equal "fields" '(1700000000 123) (list (instant-seconds t) (instant-nanoseconds t)))
    (test-assert "now is recent" (> (instant-seconds (now)) 1700000000))
    (test-equal "plus" 1700000001 (instant-seconds (instant+ t (make-duration 1))))
    (test-equal "difference" (- (* 10 1000000000) 123)
      (duration->nanoseconds (instant- (make-instant 1700000010) t)))
    (test-assert "minus duration" (instant=? (make-instant 1699999999 123) (instant- t (make-duration 1))))
    (test-assert "order" (instant<? t (instant+ t (make-duration 0 1))))
    (test-assert "equal" (instant=? t (make-instant 1700000000 123)))
    (test-assert "seconds round trip" (instant=? (make-instant 1 500000000) (seconds->instant 1.5)))
    (test-equal "to seconds" 1.5 (instant->seconds (make-instant 1 500000000))))
  (let* ([a (monotonic-now)] [b (monotonic-now)])
    (test-assert "monotonic" (duration<=? a b)))
  (let ([sw (stopwatch)])
    (test-assert "stopwatch" (not (duration-negative? (sw)))))
  (test-assert "process clock" (duration? (clock-time 'process)))
  (test-assert "thread clock" (duration? (clock-time 'thread)))
  (test-assert "unix time" (<= (abs (- (unix-time) (instant-seconds (now)))) 1)))

(test-group "datetimes"
  (let ([d (make-datetime 2024 2 28 22 30 0 0 #:offset 3600)])
    (test-equal "fields" '(2024 2 28 22 30 0 0 3600) (dt->list d))
    (test-equal "instant" 1709155800 (instant-seconds (datetime->instant d)))
    (test-equal "weekday" 3 (datetime-weekday d))
    (test-equal "add days crosses leap day" '(2024 3 1 22 30 0 0 3600) (dt->list (datetime-add d #:days 2)))
    (test-equal "add hours" '(2024 2 29 0 30 0 0 3600) (dt->list (datetime-add d #:hours 2)))
    (test-equal "with offset" '(2024 2 28 21 30 0 0 0) (dt->list (datetime-with-offset d 0)))
    (test-equal "to utc" '(2024 2 28 21 30 0 0 0) (dt->list (instant->datetime (datetime->instant d)))))
  (test-equal "month end clamps" '(2024 2 29 0 0 0 0 0) (dt->list (datetime-add (make-datetime 2024 1 31) #:months 1)))
  (test-equal "year clamps" '(2025 2 28 0 0 0 0 0) (dt->list (datetime-add (make-datetime 2024 2 29) #:years 1)))
  (test-equal "negative months" '(2023 11 30 0 0 0 0 0) (dt->list (datetime-add (make-datetime 2024 3 30) #:months -4)))
  (test-equal "truncate week" '(2024 2 26 0 0 0 0 0) (dt->list (datetime-truncate (make-datetime 2024 2 28 13 5) 'week)))
  (test-equal "truncate month" '(2024 2 1 0 0 0 0 0) (dt->list (datetime-truncate (make-datetime 2024 2 28 13 5) 'month)))
  (test-equal "days between" 366 (days-between (make-datetime 2024 1 1) (make-datetime 2025 1 1)))
  (test-equal "difference" 3600
    (duration-seconds (datetime- (make-datetime 2024 1 1 12) (make-datetime 2024 1 1 12 0 0 0 #:offset 3600))))
  (test-assert "compare across offsets"
    (datetime=? (make-datetime 2024 1 1 12) (make-datetime 2024 1 1 13 0 0 0 #:offset 3600)))
  (test-assert "invalid day"
    (guard (e [(assertion-violation? e) #t]) (make-datetime 2023 2 29) #f))
  (test-equal "iso week" '(2020 53 5)
    (call-with-values (lambda () (datetime-iso-week (make-datetime 2021 1 1))) list))
  (test-equal "far future" '(10000 1 1 0 0 0 0 0)
    (dt->list (instant->datetime (datetime->instant (make-datetime 10000 1 1))))))

(test-group "zones"
  (test-equal "utc" 0 (zone-offset-at utc (now)))
  (test-equal "fixed" 19800 (zone-offset-at (fixed-zone 19800) (now)))
  (test-equal "fixed name" "UTC+05:30" (zone-name (fixed-zone 19800)))
  (let ([ny (posix-zone "EST5EDT,M3.2.0,M11.1.0")])
    (test-equal "posix summer" -14400 (zone-offset-at ny (datetime->instant (make-datetime 2024 7 1))))
    (test-equal "posix winter" -18000 (zone-offset-at ny (datetime->instant (make-datetime 2024 1 1))))
    (test-equal "posix abbreviation" "EDT" (zone-abbreviation-at ny (datetime->instant (make-datetime 2024 7 1))))
    ;; 2024-03-10 02:00 EST jumps to 03:00 EDT.
    (test-equal "just before the change" -18000 (zone-offset-at ny (make-instant (+ 1710054000 -1))))
    (test-equal "at the change" -14400 (zone-offset-at ny (make-instant 1710054000)))
    (test-equal "gap moves forward" '(2024 3 10 3 30 0 0 -14400)
      (dt->list (make-datetime 2024 3 10 2 30 #:zone ny)))
    (test-equal "overlap takes the earlier" '(2024 11 3 1 30 0 0 -14400)
      (dt->list (make-datetime 2024 11 3 1 30 #:zone ny)))
    (test-equal "add a day across DST keeps the wall clock" '(2024 3 10 12 0 0 0 -14400)
      (dt->list (datetime-add (make-datetime 2024 3 9 12 #:zone ny) #:days 1)))
    (test-equal "add 24 hours across DST" '(2024 3 10 13 0 0 0 -14400)
      (dt->list (datetime-add (make-datetime 2024 3 9 12 #:zone ny) #:hours 24))))
  (let ([syd (posix-zone "AEST-10AEDT,M10.1.0,M4.1.0/3")])
    (test-equal "southern summer" 39600 (zone-offset-at syd (datetime->instant (make-datetime 2024 1 15))))
    (test-equal "southern winter" 36000 (zone-offset-at syd (datetime->instant (make-datetime 2024 7 15)))))
  (test-equal "posix angle names" -12600
    (zone-offset-at (posix-zone "<-0330>3:30") (now)))
  (let ([berlin (guard (e [#t #f]) (load-zone "Europe/Berlin"))])
    (when berlin
      (test-equal "tzif summer" 7200 (zone-offset-at berlin (datetime->instant (make-datetime 2024 7 1))))
      (test-equal "tzif winter" 3600 (zone-offset-at berlin (datetime->instant (make-datetime 2024 1 1))))
      (test-equal "tzif 1900" 3208 (zone-offset-at berlin (datetime->instant (make-datetime 1880 1 1))))
      (test-equal "tzif far future uses the footer rule" 7200
        (zone-offset-at berlin (datetime->instant (make-datetime 2200 7 1))))
      (test-equal "tzif abbreviation" "CEST" (zone-abbreviation-at berlin (datetime->instant (make-datetime 2024 7 1))))
      (test-equal "convert" '(2024 7 1 14 0 0 0 7200)
        (dt->list (datetime-with-zone (make-datetime 2024 7 1 12) berlin)))))
  (test-assert "unknown zone"
    (guard (e [(error? e) #t]) (load-zone "Nowhere/Atlantis") #f))
  (test-assert "unsafe zone name"
    (guard (e [(error? e) #t]) (load-zone "../../etc/passwd") #f))
  (test-assert "local zone" (zone? (local-zone))))

(test-group "RFC 3339 and ISO 8601"
  (test-equal "format utc" "2024-01-02T03:04:05Z" (format-rfc3339 (make-instant 1704164645)))
  (test-equal "format fraction" "2024-01-02T03:04:05.250Z" (format-rfc3339 (make-instant 1704164645 250000000)))
  (test-equal "format micro" "2024-01-02T03:04:05.000001Z" (format-rfc3339 (make-instant 1704164645 1000)))
  (test-equal "format digits" "2024-01-02T03:04:05.00Z" (format-rfc3339 (make-instant 1704164645) #:digits 2))
  (test-equal "format offset" "2024-01-02T08:34:05+05:30"
    (format-rfc3339 (instant->datetime (make-instant 1704164645) 19800)))
  (test-equal "format +00:00" "2024-01-02T03:04:05+00:00" (format-rfc3339 (make-instant 1704164645) #:z? #f))
  (test-equal "parse" '(2024 1 2 3 4 5 500000000 3600) (dt->list (parse-rfc3339 "2024-01-02T03:04:05.5+01:00")))
  (test-equal "parse lowercase" '(2024 1 2 3 4 5 0 0) (dt->list (parse-rfc3339 "2024-01-02t03:04:05z")))
  (test-equal "parse negative offset" -28800 (datetime-offset (parse-rfc3339 "2024-01-02 03:04:05-08:00")))
  (test-equal "parse leap second" 1483228800
    (instant-seconds (datetime->instant (parse-rfc3339 "2016-12-31T23:59:60Z"))))
  (test-assert "needs an offset" (parse-error? (lambda () (parse-rfc3339 "2024-01-02T03:04:05"))))
  (test-assert "bad day" (parse-error? (lambda () (parse-rfc3339 "2023-02-29T00:00:00Z"))))
  (test-assert "trailing junk" (parse-error? (lambda () (parse-rfc3339 "2024-01-02T03:04:05Zx"))))
  (test-equal "round trip" "1999-12-31T23:59:59.999999999-03:00"
    (format-rfc3339 (parse-rfc3339 "1999-12-31T23:59:59.999999999-03:00")))
  (test-equal "iso date" '(2024 1 2 0 0 0 0 0) (dt->list (parse-iso8601 "2024-01-02")))
  (test-equal "iso basic" '(2024 1 2 3 4 5 0 0) (dt->list (parse-iso8601 "20240102T030405Z")))
  (test-equal "iso basic offset" '(2024 1 2 3 4 5 0 -18000) (dt->list (parse-iso8601 "20240102T030405-0500")))
  (test-equal "iso hour offset" 7200 (datetime-offset (parse-iso8601 "2024-01-02T03:04+02")))
  (test-equal "iso ordinal" '(2024 2 29 0 0 0 0 0) (dt->list (parse-iso8601 "2024-060")))
  (test-equal "iso week date" '(2021 1 3 0 0 0 0 0) (dt->list (parse-iso8601 "2020-W53-7")))
  (test-equal "iso basic week" '(2024 12 30 0 0 0 0 0) (dt->list (parse-iso8601 "2025W011")))
  (test-equal "iso comma fraction" 250000000 (datetime-nanosecond (parse-iso8601 "2024-01-02T03:04:05,25")))
  (test-equal "iso fractional minute" '(3 4 30) (let ([d (parse-iso8601 "2024-01-02T03:04.5")])
                                                 (list (datetime-hour d) (datetime-minute d) (datetime-second d))))
  (test-equal "iso 24:00" '(2024 1 3 0 0 0 0 0) (dt->list (parse-iso8601 "2024-01-02T24:00:00")))
  (test-equal "iso default offset" 3600 (datetime-offset (parse-iso8601 "2024-01-02T10:00" #:offset 3600)))
  (test-assert "iso bad week" (parse-error? (lambda () (parse-iso8601 "2021-W53-1"))))
  (test-equal "iso format basic" "20240102T030405Z" (format-iso8601 (make-instant 1704164645) #:basic? #t))
  (test-equal "iso format date" "2024-01-02" (format-iso8601 (make-instant 1704164645) #:date-only? #t)))

(test-group "HTTP dates"
  (test-equal "format" "Sun, 06 Nov 1994 08:49:37 GMT" (format-http-date (make-instant 784111777)))
  (test-equal "format from seconds" "Thu, 01 Jan 1970 00:00:00 GMT" (format-http-date 0))
  (test-equal "imf-fixdate" 784111777 (instant-seconds (parse-http-date "Sun, 06 Nov 1994 08:49:37 GMT")))
  (test-equal "rfc 850" 784111777 (instant-seconds (parse-http-date "Sunday, 06-Nov-94 08:49:37 GMT")))
  (test-equal "asctime" 784111777 (instant-seconds (parse-http-date "Sun Nov  6 08:49:37 1994")))
  (test-equal "asctime two-digit day" 1700000000 (instant-seconds (parse-http-date "Tue Nov 14 22:13:20 2023")))
  (test-equal "surrounding whitespace" 784111777 (instant-seconds (parse-http-date "  Sun, 06 Nov 1994 08:49:37 GMT ")))
  (test-equal "malformed" '(#f #f #f #f)
    (map parse-http-date '("Sun, 06 Nov 1994 08:49:37 UTC" "yesterday" "Sun, 31 Feb 1994 08:49:37 GMT" ""))))

(test-group "strftime and strptime"
  (let ([d (make-datetime 2024 3 5 14 7 9 123456789 #:offset -18000)])
    (test-equal "date" "2024-03-05" (format-datetime d "%F"))
    (test-equal "time" "14:07:09" (format-datetime d "%T"))
    (test-equal "names" "Tuesday Tue March Mar" (format-datetime d "%A %a %B %b"))
    (test-equal "padding" "05| 5|5|02 PM|2" (format-datetime d "%d|%e|%-d|%I %p|%-I"))
    (test-equal "fractions" "123456|123|123456789" (format-datetime d "%f|%3N|%N"))
    (test-equal "zones" "-0500 -05:00 -05:00" (format-datetime d "%z %:z %Z"))
    (test-equal "day of year, weeks" "065 10 09 10" (format-datetime d "%j %V %U %W"))
    (test-equal "epoch" "1709665629" (format-datetime d "%s"))
    (test-equal "c locale" "Tue Mar  5 14:07:09 2024" (format-datetime d "%c"))
    (test-equal "upper" "TUESDAY" (format-datetime d "%^A"))
    (test-equal "literal percent" "100%" (format-datetime d "100%%")))
  (test-equal "utc %Z" "UTC" (format-datetime (make-instant 0) "%Z"))
  (test-equal "zone abbreviation" "EDT"
    (format-datetime (make-datetime 2024 7 1 12 #:zone (posix-zone "EST5EDT,M3.2.0,M11.1.0")) "%Z"))
  (test-equal "parse" '(2024 3 5 14 7 9 0 0) (dt->list (parse-datetime "2024-03-05 14:07:09" "%Y-%m-%d %H:%M:%S")))
  (test-equal "parse names, 12h" '(2024 3 5 14 7 0 0 0)
    (dt->list (parse-datetime "Tue, 5 March 2024 2:07 pm" "%a, %d %B %Y %I:%M %p")))
  (test-equal "parse offset" -18000 (datetime-offset (parse-datetime "2024-03-05T14:07:09-0500" "%FT%T%z")))
  (test-equal "parse colon offset" 19800 (datetime-offset (parse-datetime "10:00 +05:30" "%H:%M %:z")))
  (test-equal "parse fraction" 120000000 (datetime-nanosecond (parse-datetime "09.12" "%S.%f")))
  (test-equal "parse epoch" '(2023 11 14 22 13 20 0 0) (dt->list (parse-datetime "1700000000" "%s")))
  (test-equal "parse day of year" '(2024 2 29 0 0 0 0 0) (dt->list (parse-datetime "2024 060" "%Y %j")))
  (test-equal "parse two-digit year" '(1999 2024) (list (datetime-year (parse-datetime "99" "%y"))
                                                        (datetime-year (parse-datetime "24" "%y"))))
  (test-assert "parse mismatch" (parse-error? (lambda () (parse-datetime "2024/03/05" "%Y-%m-%d"))))
  (test-assert "parse out of range" (parse-error? (lambda () (parse-datetime "2024-13-05" "%Y-%m-%d")))))

(test-group "printing"
  (test-equal "instant" "#<instant 1970-01-01T00:00:00Z>"
    (call-with-string-output-port (lambda (p) (display (make-instant 0) p))))
  (test-equal "duration" "#<duration 1h30m0s>"
    (call-with-string-output-port (lambda (p) (display (duration #:minutes 90) p)))))

(test-end "capy time")
