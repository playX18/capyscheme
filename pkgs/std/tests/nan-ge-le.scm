;; >= and <= must be false when either operand is NaN, in every engine
;; (rust thunks, constant folder, template/JIT).
(import (rnrs))
(define nan (fl/ 0.0 0.0))
(define fails 0)
(define (check name got)
  (unless (eq? got #f)
    (set! fails (+ fails 1))
    (display "FAIL: ") (display name) (newline)))
(define (ge a b) (>= a b))
(define (le a b) (<= a b))
(check "ge nan 3.0" (ge nan 3.0))
(check "ge 3.0 nan" (ge 3.0 nan))
(check "ge nan 3" (ge nan 3))
(check "ge 3 nan" (ge 3 nan))
(check "le nan 3.0" (le nan 3.0))
(check "le 3.0 nan" (le 3.0 nan))
(check "le nan 3" (le nan 3))
(check "le 3 nan" (le 3 nan))
(check "ge nan nan" (ge nan nan))
(check "le nan nan" (le nan nan))
(check "lit ge" (>= +nan.0 1.0))
(check "lit le" (<= +nan.0 1.0))
(check "lit ge2" (>= 1 +nan.0))
(check "lit le2" (<= 1 +nan.0))
(unless (and (ge 1.0 1.0) (le 1.0 1.0) (ge 2 1.5) (le 1.5 2))
  (set! fails (+ fails 1)) (display "FAIL: sanity\n"))
(exit (if (= fails 0) 0 1))
