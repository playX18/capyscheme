;;; Tests of SRFI 115, after the examples of the SRFI and the regexp tests of Chibi Scheme,
;;; plus Unicode cases and a differential test of the DFA against the Pike VM.
(import (rnrs)
  (rnrs mutable-pairs)
  (srfi 64)
  (srfi 14)
  (srfi 115))

(test-begin "srfi 115")

(define (match->list m) (and m (regexp-match->list m)))

(define (list-head-or-all l n)
  (if (or (null? l) (= n 0)) '() (cons (car l) (list-head-or-all (cdr l) (- n 1)))))

(define-syntax test-re
  (syntax-rules ()
    [(_ expected sre str) (test-equal expected (match->list (regexp-matches sre str)))]))

(define-syntax test-re-search
  (syntax-rules ()
    [(_ expected sre str) (test-equal expected (match->list (regexp-search sre str)))]))

(test-group "basic matching"
  (test-re '("ababc" "abab") '(: ($ (* "ab")) "c") "ababc")
  (test-re '("ababc" "abab") '(: bos ($ (* "ab")) "c") "ababc")
  (test-re '("ababc" "abab") '(: ($ (* "ab")) "c" eos) "ababc")
  (test-re '("ababc" "abab") '(: bos ($ (* "ab")) "c" eos) "ababc")
  (test-re #f '(: bos ($ (* "ab")) eos "c") "ababc")
  (test-re #f '(: ($ (* "ab")) bos "c" eos) "ababc")
  (test-re '("ababc" "abab" "ab") '(: ($ (* ($ "ab"))) "c") "ababc")
  (test-re '("" #f) '(* ($ "x")) "")
  (test-re '("x" "x") '(* ($ "x")) "x")
  (test-re '("xx" "x") '(* ($ "x")) "xx")
  (test-re '("abc" "a" "b" "c") '(: ($ "a") ($ "b") ($ "c")) "abc")
  (test-re '("abbc" "bb") '(: "a" ($ (or "b" "bb")) "c") "abbc")
  (test-re '("abc" "abc") '($ (or "a" "ab" "abc")) "abc")
  (test-re '("ab" "" "ab") '(: ($ (* "a")) ($ (* "ab"))) "ab")
  (test-re '("abc" "") '(: "abc" ($ (* "d"))) "abc")
  (test-re '("abcdddd" "dddd") '(: "abc" ($ (* "d"))) "abcdddd")
  (test-re #f "abc" "abcd")
  (test-re '("abc") "abc" "abc")
  (test-re '("") '(: ) "")
  (test-re '("") '(* "a") "")
  (test-re #f '(+ "a") "")
  (test-re '("a") #\a "a")
  (test-re '("aaa") '(= 3 "a") "aaa")
  (test-re #f '(= 3 "a") "aaaa")
  (test-re '("aaaa") '(>= 3 "a") "aaaa")
  (test-re #f '(>= 3 "a") "aa")
  (test-re '("aa") '(** 1 3 "a") "aa")
  (test-re #f '(** 1 3 "a") "aaaa")
  (test-re '("") '(** 0 0 "a") "")
  (test-re '("ab" "a" "b") '(: ($ (? "a")) ($ "b")) "ab")
  (test-re '("b" "" "b") '(: ($ (? "a")) ($ "b")) "b")
  (test-re #f '(or) "")
  (test-re #f '(or) "a"))

(test-group "searching"
  (test-re-search '("xy") "xy" "xxxy")
  (test-re-search '("abc") "abc" "xxabcxx")
  (test-re-search #f "abc" "xxabxx")
  (test-re-search '("123") '(+ numeric) "abc123def")
  (test-re-search '("") '(* numeric) "abc123def")
  (test-re-search '("a" "a") '($ (or "a" "ab")) "ab")
  (test-re-search '("ab" "ab") '($ (or "ab" "a")) "ab")
  (test-re-search '("aaa") '(+ "a") "baaab")
  (test-re-search '("a") '(+? "a") "baaab")
  (test-re-search '("b") '(: (*? "a") "b") "baaab")
  (test-re-search '("aaab") '(: (*? "a") "b") "aaab")
  (test-re-search '("b") '(: (*? "a") "b") "bab")
  (test-re-search '("aa") '(** 1 2 "a") "aaa")
  (test-re-search '("a") '(**? 1 2 "a") "aaa")
  (test-re-search '("" #f) '(?? ($ "a")) "a")
  (test-re-search '("abc" "b") '(: "a" ($ any) "c") "zzabczz")
  (test-re-search '("foo123" "foo" "123") '(: ($ (+ alpha)) ($ (+ numeric))) "  foo123  ")
  (let ([m (regexp-search '(: ($ (+ alpha)) ":" (* space) ($ (+ numeric))) "key: 123 rest")])
    (test-equal "key" (regexp-match-submatch m 1))
    (test-equal "123" (regexp-match-submatch m 2))
    (test-equal 0 (regexp-match-submatch-start m 1))
    (test-equal 3 (regexp-match-submatch-end m 1))
    (test-equal 5 (regexp-match-submatch-start m 2))
    (test-equal 8 (regexp-match-submatch-end m 0))
    (test-equal 2 (regexp-match-count m)))
  (test-re-search '("cd") "cd" "abcdcd")
  (test-equal "start and end limit the search" '("cd")
    (match->list (regexp-search "cd" "cdabcd" 1)))
  (test-equal #f (regexp-search "cd" "abcd" 0 3))
  (test-equal "bos is the start argument" '("ab")
    (match->list (regexp-search '(: bos "ab") "xxab" 2)))
  (test-equal #f (regexp-search '(: bos "ab") "xxab" 1))
  (test-equal "eos is the end argument" '("ab")
    (match->list (regexp-search '(: "ab" eos) "abxx" 0 2))))

(test-group "assertions"
  (test-re-search '("foo") '(word "foo") " foo ")
  (test-re-search #f '(word "foo") "foobar")
  (test-re-search #f '(word "foo") "barfoo")
  (test-re-search '("bar") '(: bow "bar") "foo bar")
  (test-re-search #f '(: bow "bar") "foobar")
  (test-re-search '("foo") '(: "foo" eow) "foo bar")
  (test-re-search '("oob") '(: nwb "oob" nwb) "foobar")
  (test-re-search '("abc") '(word+ alpha) "123 abc 456")
  (test-re-search '("foo_bar1") 'word "  foo_bar1!")
  (test-re-search '("two") '(: bol "two") "one\ntwo")
  (test-re-search #f '(: bol "two") "one two")
  (test-re-search '("one") '(: "one" eol) "one\ntwo")
  (test-re-search '("two") '(: "two" eol) "one\ntwo")
  (test-equal '("a" "b" "c") (regexp-extract '(: bol any) "a\nb\nc"))
  (test-re-search '("x") '(: bos "x") "xyz")
  (test-re-search #f '(: bos "y") "xyz")
  (test-re-search '("z") '(: "z" eos) "xyz")
  (test-re-search #f '(: "y" eos) "xyz"))

(test-group "character sets"
  (test-re '("abc") '(+ ("abc")) "abc")
  (test-re #f '(+ ("abc")) "abd")
  (test-re '("q") '(char-set "pq") "q")
  (test-re '("m") '(/ "az") "m")
  (test-re #f '(/ "az") "M")
  (test-re '("M") '(/ "azAZ") "M")
  (test-re '("5") '(/ #\0 #\9) "5")
  (test-re '("b") '(- (/ "az") ("aeiou")) "b")
  (test-re #f '(- (/ "az") ("aeiou")) "e")
  (test-re '("e") '(and (/ "az") ("aeiou")) "e")
  (test-re '("e") '(& alpha ("aeiou")) "e")
  (test-re '("7") '(~ alpha) "7")
  (test-re #f '(~ alpha) "x")
  (test-re '("x") '(complement numeric) "x")
  (test-re '("x") '(or "x" "y") "x")
  (test-re '("\n") 'any "\n")
  (test-re #f 'nonl "\n")
  (test-re '("a") 'nonl "a")
  (test-re '("F") 'hex-digit "F")
  (test-re #f 'xdigit "g")
  (test-re '("!") 'punct "!")
  (test-re '("+") 'symbol "+")
  (test-re '(" \t") '(+ white) " \t")
  (test-re '("\x7;") 'cntrl "\x7;")
  (test-re '("x") 'graph "x")
  (test-re #f 'graph " ")
  (test-re '(" ") 'print " ")
  (test-re '("~") 'ascii "~")
  (test-re '("aZ") '(: lower upper) "aZ")
  (test-re '("5") 'alnum "5")
  (test-re '("q") (char-set #\p #\q) "q")
  (test-re '("q") `(: ,(string->char-set "pq")) "q")
  (test-re '("q") (char-set->sre (string->char-set "pq")) "q"))

(test-group "case"
  (test-re '("foo") '(w/nocase "FOO") "foo")
  (test-re '("fOo") '(w/nocase "foo") "fOo")
  (test-re '("fooBAR") '(: "foo" (w/nocase "bar")) "fooBAR")
  (test-re #f '(: "foo" (w/nocase "bar")) "FOObar")
  (test-re '("Abc") '(w/nocase (: "a" (w/case "b") "c")) "Abc")
  (test-re #f '(w/nocase (: "a" (w/case "b") "c")) "aBc")
  (test-re '("Q") '(w/nocase ("pq")) "Q")
  (test-re '("Q") '(w/nocase (/ "az")) "Q")
  (test-re '("é") '(w/nocase "É") "é")
  (test-re '("ΑΒΓ") '(w/nocase "αβγ") "ΑΒΓ")
  (test-re '("\x212A;") '(w/nocase "k") "\x212A;")
  (test-re '("\x212A;") '(w/nocase (/ "az")) "\x212A;")
  (test-re '("ς") '(w/nocase "σ") "ς")
  (test-re '("Σ") '(w/nocase "ς") "Σ")
  (test-re '("ẞ") '(w/nocase "ß") "ẞ")
  (test-re '("ǆ") '(w/nocase "ǅ") "ǆ")
  (test-re '("ω") '(w/nocase (+ upper)) "ω")
  (test-re #f '(w/nocase (~ "a")) "A"))

(test-group "unicode"
  (test-re '("héllo") '(+ alpha) "héllo")
  (test-re '("日本語") '(+ alpha) "日本語")
  (test-re #f '(w/ascii (+ alpha)) "héllo")
  (test-re '("hello") '(w/ascii (+ alpha)) "hello")
  (test-re-search '("٣٤٥") '(+ numeric) "abc٣٤٥")
  (test-re '("ÀÉ") '(+ upper) "ÀÉ")
  (test-re '("σπ") '(+ lower) "σπ")
  (test-re '("ǅ") 'title "ǅ")
  (test-re '("«") 'punct "«")
  (test-re '("€") 'symbol "€")
  (test-re '("\x3000;") 'space "\x3000;")
  (test-re-search '("λx") '(word (+ alpha)) "(λx)")
  (test-equal '("e\x301;" "a" "\r\n" "b")
    (regexp-extract 'grapheme "e\x301;a\r\nb"))
  (test-re '("e\x301;") '(: bog grapheme eog) "e\x301;")
  (test-re #f '(: "e" eog) "e\x301;")
  (test-re-search '("€€") '(+ "€") "a€€b")
  (test-re-search '("ü") '(w/nocase "Ü") "grüß"))

(test-group "named submatches"
  (let ([m (regexp-search '(: (-> year (= 4 numeric)) "-" (-> month (= 2 numeric))) "date: 2024-03")])
    (test-equal "2024" (regexp-match-submatch m 'year))
    (test-equal "03" (regexp-match-submatch m 'month))
    (test-equal "2024" (regexp-match-submatch m 1))
    (test-equal 6 (regexp-match-submatch-start m 'year))
    (test-equal 13 (regexp-match-submatch-end m 'month))
    (test-error (regexp-match-submatch m 'day)))
  (let ([m (regexp-matches '(or (-> x "a") (-> x "b")) "b")])
    (test-equal "the group of that name that matched" "b" (regexp-match-submatch m 'x)))
  (let ([m (regexp-matches '(w/nocapture ($ "a") ($ "b")) "ab")])
    (test-equal 0 (regexp-match-count m))))

(test-group "regexp objects"
  (define re (regexp '(: ($ (+ alpha)) "=" ($ (+ numeric)))))
  (test-assert (regexp? re))
  (test-assert (not (regexp? '(+ alpha))))
  (test-eq re (regexp re))
  (test-equal '(: ($ (+ alpha)) "=" ($ (+ numeric))) (regexp->sre re))
  (test-equal '("x=1" "x" "1") (match->list (regexp-matches re "x=1")))
  (test-equal '("ab12" "12") (match->list (regexp-matches `(: "ab" ,(regexp '($ (+ numeric)))) "ab12")))
  (let ([n 3])
    (test-equal '("aaa") (match->list (regexp-matches (rx (= ,n "a")) "aaa"))))
  (test-equal '("ab") (match->list (regexp-matches (rx "a" "b") "ab")))
  (test-assert (regexp-match? (regexp-matches "a" "a")))
  (test-equal #f (valid-sre? '(: "a" (* digit-is-not-a-name))))
  (test-equal #t (valid-sre? '(: "a" (* numeric))))
  (test-equal #f (valid-sre? '(** 3 1 "a")))
  (test-equal #f (valid-sre? '(= x "a")))
  (test-error (regexp '(bogus "a")))
  (test-error (regexp '(backref 1))))

(test-group "regexp-matches?"
  (test-assert (regexp-matches? '(* any) "anything"))
  (test-assert (regexp-matches? '(or "a" "ab") "ab"))
  (test-assert (not (regexp-matches? "ab" "abc")))
  (test-assert (regexp-matches? '(: (* "a") "b") "aaab"))
  (test-assert (regexp-matches? '(: bow (+ alpha) eow) "word"))
  (test-assert (not (regexp-matches? '(: bow (+ alpha) eow) "two words")))
  (test-assert (regexp-matches? "b" "abc" 1 2)))

(test-group "fold extract split partition"
  (test-equal '("192" "168" "0" "1") (regexp-extract '(+ numeric) "192.168.0.1"))
  (test-equal '() (regexp-extract '(+ numeric) "none"))
  (test-equal '("123" "456" "789") (regexp-extract '(+ numeric) "abc123def456ghi789"))
  (test-equal '("one" "two" "three" "four") (regexp-extract '(+ alpha) "one two three four"))
  (test-equal '("" "fee" "fi" "fo" "fum" "") (regexp-split '(+ space) " fee fi  fo\tfum\n"))
  (test-equal '("a" "" "b" "") (regexp-split '(",;") "a,,b,"))
  (test-equal '("a" "" "b" "") (regexp-split '(",;") "a,,b;"))
  (test-equal '("abc" "def" "ghi" "") (regexp-split '(* numeric) "abc123def456ghi789"))
  (test-equal '("abc") (regexp-split '(+ numeric) "abc"))
  (test-equal '("Hello" ", " "world" "!\n") (regexp-partition '(+ (or space punct)) "Hello, world!\n"))
  (test-equal '("" "¿" "Dónde" " " "Estás" "?") (regexp-partition '(+ (or space punct)) "¿Dónde Estás?"))
  (test-equal '("abc") (regexp-partition '(+ numeric) "abc"))
  (test-equal '(("not" . 1) ("or" . 1) ("be" . 2) ("to" . 2))
    (regexp-fold 'word
      (lambda (i m str acc)
        (let ([s (regexp-match-submatch m 0)])
          (cond
            [(assoc s acc) => (lambda (x) (set-cdr! x (+ 1 (cdr x))) acc)]
            [else `((,s . 1) ,@acc)])))
      '()
      "to be or not to be"))
  (test-equal "kons receives where the previous match ended" '((5 . "b") (2 . "b") (0 . "b"))
    (regexp-fold "b" (lambda (i m str acc) (cons (cons i (regexp-match-submatch m 0)) acc))
                 '() "abcabcxb"))
  (test-equal "finish is called with the rest" '(rest 8)
    (regexp-fold "b" (lambda (i m str acc) acc) '() "abcabcxb"
                 (lambda (i m str acc) (list 'rest i))))
  (test-equal '("3" "4") (regexp-extract 'numeric "1234" 2)))

(test-group "replace"
  (test-equal "one_two three" (regexp-replace '(+ space) "one two three" "_"))
  (test-equal "one two_three" (regexp-replace '(+ space) "one two three" "_" 0 #f 1))
  (test-equal "one two three" (regexp-replace '(+ space) "one two three" "_" 0 #f 2))
  (test-equal "one_two_three" (regexp-replace-all '(+ space) "one two three" "_"))
  (test-equal "abc" (regexp-replace-all '(+ space) "abc" "_"))
  (test-equal "  abc-abc"
    (regexp-replace '(: ($ (+ alpha)) ":" (* space)) "  abc: " '(1 "-" 1)))
  (test-equal "  abc-  abc"
    (regexp-replace '(: ($ (+ alpha)) ":" (* space)) "  abc: " '(1 "-" pre 1)))
  (test-equal "-abc  " (regexp-replace '(+ space) "  abc  " "-"))
  (test-equal "-abc-" (regexp-replace-all '(+ space) "  abc  " "-"))
  (test-equal "x[a]y[b]" (regexp-replace-all '(/ "ab") "xayb" (list "[" 0 "]")))
  (test-equal "2024/03"
    (regexp-replace '(: (-> y (= 4 numeric)) "-" (-> m (= 2 numeric))) "2024-03" '(y "/" m)))
  (test-equal "<A>b<C>" (regexp-replace-all '("ac") "abc" (lambda (m) (string-append "<" (string (char-upcase (string-ref (regexp-match-submatch m 0) 0))) ">"))))
  (test-equal "xxy-y" (regexp-replace "a" "xay" '(pre post "-")))
  (test-equal "keep ab_cd" (regexp-replace-all " " "keep ab cd" "_" 5)))

;; The DFA handles patterns whose only assertions are bos and eos; (? bol), which always
;; matches the empty string, makes a pattern use the Pike VM instead. Both must agree.
(test-group "dfa and pike agree"
  (define seed 12345)
  (define (rand n)
    (set! seed (mod (+ (* seed 1103515245) 12345) 2147483648))
    (mod (div seed 65536) n))
  (define (gen-sre depth)
    (if (= depth 0)
      (case (rand 4) [(0) "a"] [(1) "b"] [(2) "ab"] [else 'any])
      (case (rand 10)
        [(0) (list 'or (gen-sre (- depth 1)) (gen-sre (- depth 1)))]
        [(1) (list '* (gen-sre (- depth 1)))]
        [(2) (list '+ (gen-sre (- depth 1)))]
        [(3) (list '? (gen-sre (- depth 1)))]
        [(4) (list '*? (gen-sre (- depth 1)))]
        [(5) (list '$ (gen-sre (- depth 1)))]
        [(6) (list ': (gen-sre (- depth 1)) (gen-sre (- depth 1)))]
        [(7) (list '** 0 2 (gen-sre (- depth 1)))]
        [(8) (list '?? (gen-sre (- depth 1)))]
        [else (gen-sre 0)])))
  (define (gen-string)
    (let ([n (rand 9)])
      (let loop ([i 0] [acc '()])
        (if (= i n) (list->string acc) (loop (+ i 1) (cons (if (= (rand 2) 0) #\a #\b) acc))))))
  (define mismatches '())
  (do ([k 0 (+ k 1)]) ((= k 400))
    (let* ([sre (gen-sre 3)] [pike-sre `(: (? bol) ,sre)])
      (do ([j 0 (+ j 1)]) ((= j 4))
        (let ([s (gen-string)])
          (unless (and (equal? (match->list (regexp-search sre s)) (match->list (regexp-search pike-sre s)))
                       (equal? (match->list (regexp-matches sre s)) (match->list (regexp-matches pike-sre s)))
                       (equal? (regexp-matches? sre s) (regexp-matches? pike-sre s))
                       (equal? (regexp-extract sre s) (regexp-extract pike-sre s)))
            (set! mismatches (cons (list sre s) mismatches)))))))
  (test-equal '() (list-head-or-all mismatches 5)))

(test-group "long inputs"
  (define big (string-append (make-string 100000 #\x) "needle" (make-string 1000 #\y)))
  (test-equal '("needle") (match->list (regexp-search "needle" big)))
  (test-equal 100000 (regexp-match-submatch-start (regexp-search '(+ ("ne")) big) 0))
  (test-equal '("needle" "dle") (match->list (regexp-search '(: "nee" ($ (+ alpha))) (string-append (make-string 5000 #\space) "needle"))))
  (test-equal 1 (length (regexp-extract '(* "a") (string-append (make-string 1001 #\a) "b"))))
  (test-equal 1 (length (regexp-extract '(+ "y") big)))
  (test-assert (regexp-matches? '(: (* "x") "needle" (* "y")) big))
  (test-equal "pathological pattern stays linear" #f
    (regexp-matches? '(: (* (* "a")) "b") (make-string 20000 #\a)))
  (test-equal 20000 (string-length (regexp-match-submatch (regexp-search '(+ (or "a" "aa")) (make-string 20000 #\a)) 0))))

(test-end "srfi 115")
