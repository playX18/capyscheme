(import (rnrs)
  (srfi 64)
  (srfi 189))

(test-begin "srfi 189")

(define (values->list thunk) (call-with-values thunk list))

(test-group "constructors and predicates"
  (test-assert (just? (just 1)))
  (test-assert (just? (just)))
  (test-assert (nothing? (nothing)))
  (test-assert (eq? (nothing) (nothing)))
  (test-assert (maybe? (just 1)))
  (test-assert (maybe? (nothing)))
  (test-assert (not (maybe? (right 1))))
  (test-assert (left? (left 1)))
  (test-assert (right? (right 1)))
  (test-assert (either? (left)))
  (test-assert (not (either? (just 1))))
  (test-assert (not (just? 1)))
  (test-equal '(1 2) (maybe->list (list->just '(1 2))))
  (test-equal '(1 2) (either->list (list->left '(1 2))))
  (test-equal '(1 2) (either->list (list->right '(1 2))))
  (test-assert (right? (maybe->either (just 1) 'x)))
  (test-equal '(x) (either->list (maybe->either (nothing) 'x)))
  (test-assert (nothing? (either->maybe (left 1))))
  (test-equal '(1) (maybe->list (either->maybe (right 1))))
  (test-assert (left? (either-swap (right 1))))
  (test-assert (right? (either-swap (left 1)))))

(test-group "equality"
  (test-assert (maybe= eqv? (just 1) (just 1)))
  (test-assert (not (maybe= eqv? (just 1) (just 2))))
  (test-assert (maybe= eqv? (nothing) (nothing)))
  (test-assert (not (maybe= eqv? (nothing) (just 1))))
  (test-assert (maybe= eqv? (just 1 2) (just 1 2) (just 1 2)))
  (test-assert (not (maybe= eqv? (just 1 2) (just 1))))
  (test-assert (either= eqv? (right 1) (right 1)))
  (test-assert (either= eqv? (left 1) (left 1)))
  (test-assert (not (either= eqv? (left 1) (right 1))))
  (test-assert (not (either= eqv? (right 1) (right 1) (right 2)))))

(test-group "accessors"
  (test-equal 1 (maybe-ref (just 1) (lambda () 'fail)))
  (test-equal 'fail (maybe-ref (nothing) (lambda () 'fail)))
  (test-equal 3 (maybe-ref (just 1 2) (lambda () 'fail) +))
  (test-error (maybe-ref 1 (lambda () 'fail)))
  (test-equal 1 (maybe-ref/default (just 1) 0))
  (test-equal 0 (maybe-ref/default (nothing) 0))
  (test-equal '(0 1) (values->list (lambda () (maybe-ref/default (nothing) 0 1))))
  (test-equal 1 (either-ref (right 1) (lambda (x) (list 'left x))))
  (test-equal '(left 1) (either-ref (left 1) (lambda (x) (list 'left x))))
  (test-equal 10 (either-ref (right 2 5) (lambda x x) *))
  (test-equal 0 (either-ref/default (left 1) 0))
  (test-equal 1 (either-ref/default (right 1) 0)))

(test-group "join and bind"
  (test-equal '(1) (maybe->list (maybe-join (just (just 1)))))
  (test-assert (nothing? (maybe-join (just (nothing)))))
  (test-assert (nothing? (maybe-join (nothing))))
  (test-error (maybe-join (just 1)))
  (test-equal '(1) (either->list (either-join (right (right 1)))))
  (test-assert (left? (either-join (left 1))))
  (let ([inc (lambda (x) (just (+ x 1)))]
        [fail (lambda (x) (nothing))])
    (test-equal '(3) (maybe->list (maybe-bind (just 1) inc inc)))
    (test-assert (nothing? (maybe-bind (just 1) fail inc)))
    (test-assert (nothing? (maybe-bind (nothing) inc)))
    (test-equal '(3) (maybe->list ((maybe-compose inc inc) 1)))
    (test-assert (nothing? ((maybe-compose inc fail) 1))))
  (let ([inc (lambda (x) (right (+ x 1)))]
        [fail (lambda (x) (left x))])
    (test-equal '(3) (either->list (either-bind (right 1) inc inc)))
    (test-equal '(2) (either->list (either-bind (right 1) inc fail inc)))
    (test-equal '(3) (either->list ((either-compose inc inc) 1)))))

(test-group "sequence operations"
  (test-equal 1 (maybe-length (just 1 2)))
  (test-equal 0 (maybe-length (nothing)))
  (test-equal 1 (either-length (right 1)))
  (test-equal 0 (either-length (left 1)))
  (test-equal '(2) (maybe->list (maybe-filter even? (just 2))))
  (test-assert (nothing? (maybe-filter even? (just 1))))
  (test-assert (nothing? (maybe-remove even? (just 2))))
  (test-equal '(1) (maybe->list (maybe-remove even? (just 1))))
  (test-equal '(x) (either->list (either-filter even? (right 1) 'x)))
  (test-equal '(2) (either->list (either-filter even? (right 2) 'x)))
  (test-equal '(x) (either->list (either-remove even? (right 2) 'x)))
  (test-equal "the default aggregator is list" '(((1) (2) (3))) (maybe->list (maybe-sequence (list (just 1) (just 2) (just 3)) map)))
  (test-assert (nothing? (maybe-sequence (list (just 1) (nothing) (just 3)) map)))
  (test-equal '(#(3 7)) (maybe->list (maybe-sequence (vector (just 1 2) (just 3 4)) vector-map +)))
  (test-equal '(((1) (2))) (either->list (either-sequence (list (right 1) (right 2)) map)))
  (test-equal '(bad) (either->list (either-sequence (list (right 1) (left 'bad)) map))))

(test-group "conversion"
  (test-equal '(1 2) (maybe->list (just 1 2)))
  (test-equal '() (maybe->list (nothing)))
  (test-assert (nothing? (list->maybe '())))
  (test-equal '(1) (maybe->list (list->maybe '(1))))
  (test-equal '(x) (either->list (list->either '() 'x)))
  (test-equal 1 (maybe->truth (just 1)))
  (test-equal #f (maybe->truth (nothing)))
  (test-equal #f (either->truth (left 1)))
  (test-equal 1 (either->truth (right 1)))
  (test-assert (nothing? (truth->maybe #f)))
  (test-equal '(1) (maybe->list (truth->maybe 1)))
  (test-equal '(x) (either->list (truth->either #f 'x)))
  (test-equal '(1 2) (maybe->list-truth (just 1 2)))
  (test-equal #f (maybe->list-truth (nothing)))
  (test-equal '(1) (either->list-truth (right 1)))
  (test-equal '(1 2) (maybe->list (list-truth->maybe '(1 2))))
  (test-assert (nothing? (list-truth->maybe #f)))
  (test-assert (left? (list-truth->either #f)))
  (test-equal 1 (maybe->generation (just 1)))
  (test-assert (eof-object? (maybe->generation (nothing))))
  (test-assert (eof-object? (either->generation (left 1))))
  (test-assert (nothing? (generation->maybe (eof-object))))
  (test-equal '(1) (maybe->list (generation->maybe 1)))
  (test-assert (left? (generation->either (eof-object))))
  (test-equal '(1 2) (values->list (lambda () (maybe->values (just 1 2)))))
  (test-equal '() (values->list (lambda () (maybe->values (nothing)))))
  (test-equal '(1) (values->list (lambda () (either->values (right 1)))))
  (test-assert (nothing? (values->maybe (lambda () (values)))))
  (test-equal '(1 2) (maybe->list (values->maybe (lambda () (values 1 2)))))
  (test-assert (left? (values->either (lambda () (values)))))
  (test-equal '(1 #t) (values->list (lambda () (maybe->two-values (just 1)))))
  (test-equal '(#f #f) (values->list (lambda () (maybe->two-values (nothing)))))
  (test-equal '(5) (maybe->list (two-values->maybe (lambda () (values 5 #t)))))
  (test-assert (nothing? (two-values->maybe (lambda () (values 5 #f)))))
  (test-equal '(oops) (either->list (exception->either symbol? (lambda () (raise 'oops)))))
  (test-equal '(1 2) (either->list (exception->either symbol? (lambda () (values 1 2)))))
  (test-equal "an exception the predicate rejects is re-raised" 42
    (guard (e [(number? e) e])
      (exception->either symbol? (lambda () (raise 42))))))

(test-group "map fold unfold"
  (test-equal '(2) (maybe->list (maybe-map (lambda (x) (+ x 1)) (just 1))))
  (test-equal '(1 2) (maybe->list (maybe-map (lambda (x) (values x (+ x 1))) (just 1))))
  (test-assert (nothing? (maybe-map (lambda (x) (+ x 1)) (nothing))))
  (test-equal '(2) (either->list (either-map (lambda (x) (+ x 1)) (right 1))))
  (test-equal '(1) (either->list (either-map (lambda (x) (+ x 1)) (left 1))))
  (let ([n 0])
    (maybe-for-each (lambda (x) (set! n x)) (just 5))
    (maybe-for-each (lambda (x) (set! n 99)) (nothing))
    (either-for-each (lambda (x) (set! n (+ n x))) (right 1))
    (either-for-each (lambda (x) (set! n 99)) (left 1))
    (test-equal 6 n))
  (test-equal 3 (maybe-fold + 1 (just 2)))
  (test-equal 1 (maybe-fold + 1 (nothing)))
  (test-equal 6 (maybe-fold + 1 (just 2 3)))
  (test-equal 3 (either-fold + 1 (right 2)))
  (test-equal 1 (either-fold + 1 (left 2)))
  (test-assert (nothing? (maybe-unfold (lambda (x) (> x 2)) (lambda (x) (* x 10)) (lambda (x) (+ x 1)) 3)))
  (test-equal '(20) (maybe->list (maybe-unfold (lambda (x) (> x 2)) (lambda (x) (* x 10)) (lambda (x) (+ x 1)) 2)))
  (test-error (maybe-unfold (lambda (x) (> x 2)) (lambda (x) x) (lambda (x) (+ x 1)) 0))
  (test-equal '(3) (either->list (either-unfold (lambda (x) (> x 2)) (lambda (x) x) (lambda (x) (+ x 1)) 3)))
  (test-assert (left? (either-unfold (lambda (x) (> x 2)) (lambda (x) x) (lambda (x) (+ x 1)) 3))))

(test-group "syntax"
  (test-equal 'yes (maybe-if (just 1) 'yes 'no))
  (test-equal 'no (maybe-if (nothing) 'yes 'no))
  (test-assert (just? (maybe-and)))
  (test-equal '(2) (maybe->list (maybe-and (just 1) (just 2))))
  (test-assert (nothing? (maybe-and (just 1) (nothing) (just 2))))
  (test-assert (nothing? (maybe-or)))
  (test-equal '(1) (maybe->list (maybe-or (nothing) (just 1) (just 2))))
  (test-assert (nothing? (maybe-or (nothing) (nothing))))
  (test-equal '(3) (maybe->list (maybe-let* ([x (just 1)] [y (just 2)]) (just (+ x y)))))
  (test-assert (nothing? (maybe-let* ([x (just 1)] [y (nothing)]) (just (+ x y)))))
  (let ([m (just 5)])
    (test-equal '(5) (maybe->list (maybe-let* (m ((just 1))) m))))
  (test-equal '(2) (maybe->list (maybe-let* ([x (just 1)] [y (just 2)]))))
  (test-equal '(3) (maybe->list (maybe-let*-values ([(a b) (just 1 2)]) (just (+ a b)))))
  (test-equal '((2 3)) (maybe->list (maybe-let*-values ([(a . rest) (just 1 2 3)]) (just rest))))
  (test-assert (right? (either-and)))
  (test-equal '(2) (either->list (either-and (right 1) (right 2))))
  (test-equal '(bad) (either->list (either-and (right 1) (left 'bad) (right 2))))
  (test-equal '(1) (either->list (either-or (left 0) (right 1))))
  (test-assert (left? (either-or (left 0) (left 1))))
  (test-equal '(3) (either->list (either-let* ([x (right 1)] [y (right 2)]) (right (+ x y)))))
  (test-equal '(e) (either->list (either-let* ([x (right 1)] [y (left 'e)]) (right (+ x y)))))
  (test-equal '(3) (either->list (either-let*-values ([(a b) (right 1 2)]) (right (+ a b)))))
  (test-equal '(boom) (either->list (either-guard symbol? (raise 'boom))))
  (test-equal '(7) (either->list (either-guard symbol? (+ 3 4)))))

(test-group "trivalent logic"
  (define t (just #t))
  (define f (just #f))
  (define u (nothing))
  (define (val m) (if (nothing? m) 'u (maybe->truth m)))
  (test-equal #f (val (tri-not t)))
  (test-equal #t (val (tri-not f)))
  (test-equal 'u (val (tri-not u)))
  (test-equal #t (val (tri=? t t)))
  (test-equal #t (val (tri=? f f f)))
  (test-equal #f (val (tri=? t f)))
  (test-equal 'u (val (tri=? t u)))
  (test-equal #t (val (tri-and)))
  (test-equal #t (val (tri-and t t)))
  (test-equal #f (val (tri-and t f)))
  (test-equal #f (val (tri-and u f)))
  (test-equal 'u (val (tri-and t u)))
  (test-equal #f (val (tri-or)))
  (test-equal #t (val (tri-or f t)))
  (test-equal #t (val (tri-or u t)))
  (test-equal 'u (val (tri-or f u)))
  (test-equal #f (val (tri-or f f)))
  (test-equal 'u (val (tri-merge)))
  (test-equal #f (val (tri-merge u f t)))
  (test-equal 'u (val (tri-merge u u)))
  (test-equal #t (val (tri-and (just 'x)))))

(test-end "srfi 189")
