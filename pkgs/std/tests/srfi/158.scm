;;; Adapted from the SRFI 158 test suite, with extra cases.
(import (rnrs)
  (srfi 64)
  (srfi 158))

(test-begin "srfi 158")

(define g->l generator->list)

(test-group "constructors"
  (test-equal '() (g->l (generator)))
  (test-equal '(1 2 3) (g->l (generator 1 2 3)))
  (test-equal '(1 2 3 1 2) (g->l (circular-generator 1 2 3) 5))
  (test-equal '(8 9 10) (g->l (make-iota-generator 3 8)))
  (test-equal '(8 10 12) (g->l (make-iota-generator 3 8 2)))
  (test-equal '(0 1 2) (g->l (make-iota-generator 3)))
  (test-equal '(0.0 0.1 0.2) (map (lambda (x) (/ (round (* x 10)) 10)) (g->l (make-iota-generator 3 0.0 0.1))))
  (test-assert (exact? (car (g->l (make-iota-generator 3 1 1)))))
  (test-equal '(3 4 5 6) (g->l (make-range-generator 3) 4))
  (test-equal '(3 4 5 6 7) (g->l (make-range-generator 3 8)))
  (test-equal '(3 5 7) (g->l (make-range-generator 3 8 2)))
  (test-equal '(8 6 4) (g->l (make-range-generator 8 3 -2)))
  (let ([g (make-coroutine-generator
             (lambda (yield) (let loop ([i 0]) (when (< i 3) (yield i) (loop (+ i 1))))))])
    (test-equal '(0 1 2) (g->l g))
    (test-assert "stays exhausted" (eof-object? (g))))
  (test-equal '(1 2 3) (g->l (list->generator '(1 2 3))))
  (test-equal '(1 2 3) (g->l (vector->generator '#(1 2 3))))
  (test-equal '(2 3) (g->l (vector->generator '#(1 2 3) 1)))
  (test-equal '(2) (g->l (vector->generator '#(1 2 3) 1 2)))
  (test-equal '(3 2 1) (g->l (reverse-vector->generator '#(1 2 3))))
  (test-equal '(3 2) (g->l (reverse-vector->generator '#(1 2 3) 1)))
  (test-equal '(2) (g->l (reverse-vector->generator '#(1 2 3) 1 2)))
  (test-equal '(#\a #\b #\c) (g->l (string->generator "abc")))
  (test-equal '(#\b) (g->l (string->generator "abc" 1 2)))
  (test-equal '(1 2 3) (g->l (bytevector->generator (u8-list->bytevector (list 1 2 3)))))
  (test-equal '(2 3) (g->l (bytevector->generator (u8-list->bytevector (list 1 2 3)) 1)))
  (test-equal '(1 2 3) (g->l (make-for-each-generator for-each '(1 2 3))))
  (test-equal '(a b) (g->l (make-for-each-generator vector-for-each '#(a b))))
  (test-equal '(0 2 4 6 8 10)
    (g->l (make-unfold-generator (lambda (s) (> s 5)) (lambda (s) (* s 2)) (lambda (s) (+ s 1)) 0))))

(test-group "operators"
  (test-equal '(a b 1 2) (g->l (gcons* 'a 'b (generator 1 2))))
  (test-equal '(1 2) (g->l (gcons* (generator 1 2))))
  (test-equal '(1 2 3 4) (g->l (gappend (generator 1 2) (generator) (generator 3 4))))
  (test-equal '() (g->l (gappend)))
  (test-equal '(1 2 3 4 5) (g->l (gflatten (generator '(1 2) '() '(3 4 5)))))
  (test-equal '((1 2 3) (4 5 6) (7)) (g->l (ggroup (make-iota-generator 7 1) 3)))
  (test-equal '((1 2 3) (4 5 6) (7 0 0)) (g->l (ggroup (make-iota-generator 7 1) 3 0)))
  (test-equal '(1 2 3) (g->l (gmerge < (generator 1 2 3))))
  (test-equal '(1 2 3 4 5 6) (g->l (gmerge < (generator 1 3 5) (generator 2 4 6))))
  (test-equal '(1 2 3 4 5 6 7) (g->l (gmerge < (generator 1 4 7) (generator 2 5) (generator 3 6))))
  (test-equal '() (g->l (gmerge <)))
  (test-equal '(-1 -2 -3) (g->l (gmap - (generator 1 2 3))))
  (test-equal '(11 22) (g->l (gmap + (generator 1 2 3) (generator 10 20))))
  (test-equal '(10 11 13)
    (g->l (gcombine (lambda (x seed) (values (+ x seed) (+ seed 1))) 10 (generator 0 0 1))))
  (test-equal '(0 1 3 6)
    (g->l (gcombine (lambda (x seed) (let ([s (+ x seed)]) (values s s))) 0 (generator 0 1 2 3))))
  (test-equal '(1 3 5) (g->l (gfilter odd? (make-iota-generator 6))))
  (test-equal '(0 2 4) (g->l (gremove odd? (make-iota-generator 6))))
  (test-equal '(a b c)
    (g->l (gstate-filter (lambda (x seen) (if (memq x seen) (values #f seen) (values #t (cons x seen))))
                         '() (generator 'a 'b 'a 'c 'b))))
  (test-equal '(1 2) (g->l (gtake (generator 1 2 3) 2)))
  (test-equal '(1 2) (g->l (gtake (generator 1 2) 5)))
  (test-equal '(1 2 x x) (g->l (gtake (generator 1 2) 4 'x)))
  (test-equal '(3) (g->l (gdrop (generator 1 2 3) 2)))
  (test-equal '() (g->l (gdrop (generator 1 2 3) 5)))
  (test-equal '(1 2) (g->l (gtake-while (lambda (x) (< x 3)) (generator 1 2 3 1))))
  (test-equal '(3 1) (g->l (gdrop-while (lambda (x) (< x 3)) (generator 1 2 3 1))))
  (test-equal '(1 3 1) (g->l (gdelete 2 (generator 1 2 3 2 1))))
  (test-equal '(1 3) (g->l (gdelete 2.0 (generator 1 2 3) =)))
  (test-equal '(a b c a) (g->l (gdelete-neighbor-dups (generator 'a 'a 'b 'c 'c 'c 'a))))
  (test-equal '(1 2) (g->l (gdelete-neighbor-dups (generator 1 1.0 2) =)))
  (test-equal '(a c d) (g->l (gindex (list->generator '(a b c d e)) (generator 0 2 3))))
  (test-equal '(e) (g->l (gindex (list->generator '(a b c d e)) (generator 4 9))))
  (test-equal '(a d) (g->l (gselect (generator 'a 'b 'c 'd) (generator #t #f #f #t)))))

(test-group "consumers"
  (test-equal '(1 2 3) (generator->list (generator 1 2 3)))
  (test-equal '(1 2) (generator->list (generator 1 2 3) 2))
  (test-equal '(3 2 1) (generator->reverse-list (generator 1 2 3)))
  (test-equal '(2 1) (generator->reverse-list (generator 1 2 3) 2))
  (test-equal '#(1 2 3) (generator->vector (generator 1 2 3)))
  (test-equal '#(1 2) (generator->vector (generator 1 2 3) 2))
  (let ([v (vector 0 0 0 0)])
    (test-equal 2 (generator->vector! v 1 (generator 'a 'b)))
    (test-equal '#(0 a b 0) v))
  (let ([v (vector 0 0)])
    (test-equal 1 (generator->vector! v 1 (generator 'a 'b)))
    (test-equal '#(0 a) v))
  (test-equal "abc" (generator->string (generator #\a #\b #\c)))
  (test-equal "ab" (generator->string (generator #\a #\b #\c) 2))
  (test-equal 6 (generator-fold + 0 (generator 1 2 3)))
  (test-equal '(3 2 1) (generator-fold cons '() (generator 1 2 3)))
  (test-equal 21 (generator-fold + 0 (generator 1 2 3) (generator 4 5 6)))
  (let ([acc '()])
    (generator-for-each (lambda (x) (set! acc (cons x acc))) (generator 1 2 3))
    (test-equal '(3 2 1) acc))
  (let ([acc '()])
    (generator-for-each (lambda (x y) (set! acc (cons (+ x y) acc))) (generator 1 2 3) (generator 10 20))
    (test-equal '(22 11) acc))
  (test-equal '(-1 -2) (generator-map->list - (generator 1 2)))
  (test-equal '(11 22) (generator-map->list + (generator 1 2) (generator 10 20 30)))
  (test-equal 4 (generator-find (lambda (x) (> x 3)) (make-iota-generator 10)))
  (test-equal #f (generator-find (lambda (x) (> x 30)) (make-iota-generator 10)))
  (test-equal 5 (generator-count odd? (make-iota-generator 10)))
  (test-equal #t (generator-any odd? (generator 2 4 5)))
  (test-equal #f (generator-any odd? (generator 2 4)))
  (test-equal 3 (generator-any (lambda (x) (and (odd? x) x)) (generator 2 3 5)))
  (test-equal #t (generator-every odd? (generator 1 3)))
  (test-equal #f (generator-every odd? (generator 1 2)))
  (test-equal #t (generator-every odd? (generator)))
  (test-equal 5 (generator-every (lambda (x) (and (odd? x) x)) (generator 1 3 5)))
  (test-equal '(1 2 3)
    (generator-unfold (generator 1 2 3)
      (lambda (stop? mapper successor seed)
        (let loop ([seed seed] [acc '()])
          (if (stop? seed) (reverse acc) (loop (successor seed) (cons (mapper seed) acc))))))))

(test-group "accumulators"
  (define (run acc . xs)
    (for-each acc xs)
    (acc (eof-object)))
  (test-equal 6 (run (make-accumulator + 0 (lambda (x) x)) 1 2 3))
  (test-equal '(3 2 1) (run (make-accumulator cons '() (lambda (x) x)) 1 2 3))
  (test-equal 3 (run (count-accumulator) 'a 'b 'c))
  (test-equal 0 (run (count-accumulator)))
  (test-equal '(1 2 3) (run (list-accumulator) 1 2 3))
  (test-equal '(3 2 1) (run (reverse-list-accumulator) 1 2 3))
  (test-equal '#(1 2 3) (run (vector-accumulator) 1 2 3))
  (test-equal '#(3 2 1) (run (reverse-vector-accumulator) 1 2 3))
  (let ([v (vector 0 0 0 0)])
    (test-eq v (run (vector-accumulator! v 1) 'a 'b))
    (test-equal '#(0 a b 0) v))
  (test-equal "abc" (run (string-accumulator) #\a #\b #\c))
  (test-equal (u8-list->bytevector (list 1 2 3)) (run (bytevector-accumulator) 1 2 3))
  (let ([bv (make-bytevector 4 0)])
    (test-eq bv (run (bytevector-accumulator! bv 2) 9 8))
    (test-equal (u8-list->bytevector (list 0 0 9 8)) bv))
  (test-equal 6 (run (sum-accumulator) 1 2 3))
  (test-equal 0 (run (sum-accumulator)))
  (test-equal 24 (run (product-accumulator) 2 3 4))
  (test-equal 1 (run (product-accumulator))))

(test-group "coroutines"
  (define (tree-walker tree)
    (make-coroutine-generator
      (lambda (yield)
        (let walk ([t tree])
          (cond
            [(null? t) #f]
            [(pair? t) (walk (car t)) (walk (cdr t))]
            [else (yield t)])))))
  (test-equal '(1 2 3 4 5) (g->l (tree-walker '((1 (2)) 3 (4 (5))))))
  (test-equal '(1 2) (g->l (gtake (tree-walker '(1 2 3 4)) 2)))
  (test-equal "interleaved coroutines" '((1 . a) (2 . b))
    (g->l (gmap cons (tree-walker '(1 (2))) (tree-walker '((a) b))))))

(test-end "srfi 158")
