;;; Adapted from the SRFI 152 test suite, with extra cases.
(import (except (rnrs) string->list string-copy string-for-each)
  (srfi 64)
  (srfi 152))

(test-begin "srfi 152")

(test-group "predicates"
  (test-assert (string-null? ""))
  (test-assert (not (string-null? "abc")))
  (test-equal #t (string-every char-alphabetic? "abc"))
  (test-equal #f (string-every char-alphabetic? "ab1"))
  (test-equal #t (string-every char-alphabetic? ""))
  (test-equal #\c (string-every (lambda (c) (and (char-alphabetic? c) c)) "abc"))
  (test-equal #t (string-every char-alphabetic? "1abc2" 1 4))
  (test-equal #f (string-any char-numeric? "abc"))
  (test-equal #t (string-any char-numeric? "ab1"))
  (test-equal #f (string-any char-numeric? "ab1" 0 2))
  (test-equal #\1 (string-any (lambda (c) (and (char-numeric? c) c)) "ab1")))

(test-group "constructors"
  (test-equal "abc" (string-tabulate (lambda (i) (integer->char (+ i 97))) 3))
  (test-equal "" (string-tabulate (lambda (i) #\x) 0))
  (test-equal "abcde"
    (string-unfold null? car cdr '(#\a #\b #\c #\d #\e)))
  (test-equal "<<abc>>"
    (string-unfold null? car cdr '(#\a #\b #\c) "<<" (lambda (x) ">>")))
  (test-equal "edcba"
    (string-unfold-right null? car cdr '(#\a #\b #\c #\d #\e)))
  (test-equal ">>cba<<"
    (string-unfold-right null? car cdr '(#\a #\b #\c) "<<" (lambda (x) ">>")))
  (test-equal "aabbcc"
    (string-unfold null? (lambda (l) (make-string 2 (car l))) cdr '(#\a #\b #\c))))

(test-group "conversion"
  (test-equal '(#\a #\b #\c) (string->list "abc"))
  (test-equal '(#\b #\c) (string->list "abc" 1))
  (test-equal '(#\b) (string->list "abc" 1 2))
  (test-equal '#(#\a #\b #\c) (string->vector "abc"))
  (test-equal '#(#\b) (string->vector "abc" 1 2))
  (test-equal "abc" (vector->string '#(#\a #\b #\c)))
  (test-equal "b" (vector->string '#(#\a #\b #\c) 1 2))
  (test-equal "cba" (reverse-list->string '(#\a #\b #\c)))
  (test-equal "" (reverse-list->string '())))

(test-group "selection"
  (test-equal "abc" (string-copy "abc"))
  (test-equal "bc" (string-copy "abc" 1))
  (test-equal "b" (string-copy "abc" 1 2))
  (test-error (string-copy "abc" 2 5))
  (let ([s "abc"]) (test-assert (not (eq? s (string-copy s)))))
  (test-equal "ab" (string-take "abcde" 2))
  (test-equal "cde" (string-drop "abcde" 2))
  (test-equal "de" (string-take-right "abcde" 2))
  (test-equal "abc" (string-drop-right "abcde" 2))
  (test-error (string-take "abc" 4))
  (test-equal "  325" (string-pad "325" 5))
  (test-equal "71325" (string-pad "8871325" 5))
  (test-equal "00325" (string-pad "325" 5 #\0))
  (test-equal "  32" (string-pad "1325" 4 #\space 1 3))
  (test-equal "325  " (string-pad-right "325" 5))
  (test-equal "88713" (string-pad-right "8871325" 5))
  (test-equal "325**" (string-pad-right "325" 5 #\*))
  (test-equal "abc  " (string-trim "  abc  "))
  (test-equal "  abc" (string-trim-right "  abc  "))
  (test-equal "abc" (string-trim-both "  abc  "))
  (test-equal "" (string-trim-both "    "))
  (test-equal "abcxx" (string-trim "xxabcxx" (lambda (c) (char=? c #\x))))
  (test-equal "abc" (string-trim-both "xxabcxx" (lambda (c) (char=? c #\x))))
  (test-equal "b" (string-trim-both " a b c " char-whitespace? 2 5)))

(test-group "replacement"
  (test-equal "The miserable perl programmer endured daily ridicule."
    (string-replace "The TCL programmer endured daily ridicule."
                    "another miserable perl drone" 4 7 8 22))
  (test-equal "It's lots of fun to code it up in Scheme."
    (string-replace "It's easy to code it up in Scheme." "lots of fun" 5 9))
  (test-equal "xabc" (string-replace "abc" "x" 0 0))
  (test-equal "abcx" (string-replace "abc" "x" 3 3)))

(test-group "comparison"
  (test-assert (string=? "abc" "abc" "abc"))
  (test-assert (string<? "abc" "abd"))
  (test-assert (string-ci=? "ABC" "abc"))
  (test-assert (string-ci<? "abc" "ABD")))

(test-group "prefixes and suffixes"
  (test-equal 3 (string-prefix-length "abcdef" "abcxyz"))
  (test-equal 0 (string-prefix-length "abc" "xyz"))
  (test-equal 2 (string-prefix-length "abcdef" "xbcxyz" 1 6 1 6))
  (test-equal 3 (string-suffix-length "xyzdef" "abcdef"))
  (test-equal 0 (string-suffix-length "abc" "abd"))
  (test-assert (string-prefix? "abc" "abcdef"))
  (test-assert (not (string-prefix? "abd" "abcdef")))
  (test-assert (string-prefix? "" "abc"))
  (test-assert (not (string-prefix? "abcd" "abc")))
  (test-assert (string-suffix? "def" "abcdef"))
  (test-assert (not (string-suffix? "deg" "abcdef")))
  (test-assert (string-prefix? "bc" "abcd" 0 2 1 4)))

(test-group "searching"
  (test-equal 3 (string-index "abc1d" char-numeric?))
  (test-equal 2 (string-index "ab1c1" char-numeric?))
  (test-equal #f (string-index "abc" char-numeric?))
  (test-equal 4 (string-index "ab1c1" char-numeric? 3))
  (test-equal #f (string-index "ab1c1" char-numeric? 3 4))
  (test-equal 4 (string-index-right "ab1c1" char-numeric?))
  (test-equal 2 (string-index-right "ab1c1" char-numeric? 0 4))
  (test-equal #f (string-index-right "abc" char-numeric?))
  (test-equal 2 (string-skip "  abc" char-whitespace?))
  (test-equal #f (string-skip "   " char-whitespace?))
  (test-equal 2 (string-skip-right "abc  " char-whitespace?))
  (test-equal 0 (string-contains "abc" ""))
  (test-equal 2 (string-contains "ababc" "abc"))
  (test-equal #f (string-contains "ababc" "abd"))
  (test-equal 0 (string-contains "abc" "abc"))
  (test-equal #f (string-contains "ab" "abc"))
  (test-equal 5 (string-contains "abcabcab" "ca" 3))
  (test-equal #f (string-contains "abcabcab" "ca" 3 5))
  (test-equal 2 (string-contains "xxabcxx" "zabcz" 0 7 1 4))
  (test-equal 3 (string-contains-right "abcabc" "abc"))
  (test-equal 0 (string-contains-right "abcabc" "abc" 0 5))
  (test-equal 6 (string-contains-right "abcabc" ""))
  (test-equal #f (string-contains-right "abc" "x")))

(test-group "the whole string"
  (test-equal "abcdef" (string-concatenate '("ab" "cd" "ef")))
  (test-equal "" (string-concatenate '()))
  (test-equal "efcdab" (string-concatenate-reverse '("ab" "cd" "ef")))
  (test-equal "efcdabxy" (string-concatenate-reverse '("ab" "cd" "ef") "xyz" 2))
  (test-equal "a b c" (string-join '("a" "b" "c")))
  (test-equal "a, b, c" (string-join '("a" "b" "c") ", "))
  (test-equal "" (string-join '()))
  (test-equal ":a:b" (string-join '("a" "b") ":" 'prefix))
  (test-equal "a:b:" (string-join '("a" "b") ":" 'suffix))
  (test-equal "a" (string-join '("a") ":" 'strict-infix))
  (test-error (string-join '() ":" 'strict-infix))
  (test-equal '(#\c #\b #\a) (string-fold cons '() "abc"))
  (test-equal '(#\a #\b #\c) (string-fold-right cons '() "abc"))
  (test-equal 2 (string-fold (lambda (c n) (if (char=? c #\a) (+ n 1) n)) 0 "banana" 0 4))
  (test-equal "ABC" (string-map char-upcase "abc"))
  (test-equal "bdf"
    (string-map (lambda (a b) (integer->char (+ (char->integer a) (- (char->integer b) 48))))
                "abcd" "123"))
  (let ([acc '()])
    (string-for-each (lambda (c) (set! acc (cons c acc))) "abc")
    (test-equal '(#\c #\b #\a) acc))
  (let ([acc '()])
    (string-for-each (lambda (a b) (set! acc (cons (list a b) acc))) "ab" "xyz")
    (test-equal '((#\b #\y) (#\a #\x)) acc))
  (test-equal 3 (string-count "a1b2c3" char-numeric?))
  (test-equal 1 (string-count "a1b2c3" char-numeric? 2 4))
  (test-equal "123" (string-filter char-numeric? "a1b2c3"))
  (test-equal "abc" (string-remove char-numeric? "a1b2c3"))
  (test-equal "2" (string-filter char-numeric? "a1b2c3" 2 4))
  (test-equal "" (string-filter char-numeric? "")))

(test-group "replication and splitting"
  (test-equal "cdefab" (string-replicate "abcdef" 2 8))
  (test-equal "efabcd" (string-replicate "abcdef" -2 4))
  (test-equal "abcabca" (string-replicate "abc" 0 7))
  (test-equal "" (string-replicate "abc" 3 3))
  (test-equal "cdcdc" (string-replicate "abcdef" 0 5 2 4))
  (test-equal '("ab" "cd" "e") (string-segment "abcde" 2))
  (test-equal '("abc") (string-segment "abc" 5))
  (test-equal '() (string-segment "" 2))
  (test-equal '("a" "b" "c") (string-split "a b c" " "))
  (test-equal '("a" "" "b") (string-split "a,,b" ","))
  (test-equal '("" "a" "b" "") (string-split ",a,b," ","))
  (test-equal '("a" "b" "") (string-split ",a,b," "," 'prefix))
  (test-equal '("" "a" "b") (string-split ",a,b," "," 'suffix))
  (test-equal '() (string-split "" ","))
  (test-error (string-split "" "," 'strict-infix))
  (test-equal '("a" "b,c") (string-split "a,b,c" "," 'infix 1))
  (test-equal '("a,b,c") (string-split "a,b,c" "," 'infix 0))
  (test-equal '("a" "b" "c") (string-split "abc" ""))
  (test-equal '("ab" "cd") (string-split "ab\r\ncd" "\r\n"))
  (test-equal '("b" "c") (string-split "a b c d" " " 'infix #f 2 5)))

(test-group "mutation"
  (let ([s (make-string 3 #\a)])
    (string-set! s 1 #\b)
    (test-equal "aba" s)
    (string-fill! s #\z)
    (test-equal "zzz" s)
    (string-fill! s #\y 1)
    (test-equal "zyy" s)
    (string-fill! s #\x 0 1)
    (test-equal "xyy" s))
  (let ([s (string-copy "abcde")])
    (string-copy! s 1 "xyz")
    (test-equal "axyze" s))
  (let ([s (string-copy "abcde")])
    (string-copy! s 0 "xyz" 1)
    (test-equal "yzcde" s))
  (let ([s (string-copy "abcde")])
    (string-copy! s 1 s 0 3)
    (test-equal "overlap to the right" "aabce" s))
  (let ([s (string-copy "abcde")])
    (string-copy! s 0 s 2)
    (test-equal "overlap to the left" "cdede" s))
  (test-error (string-copy! (make-string 2) 1 "abc")))

(test-group "unicode"
  (test-equal "ÉCOLE" (string-map char-upcase "école"))
  (test-equal 2 (string-index "αβγ" (lambda (c) (char=? c #\γ))))
  (test-equal 1 (string-contains "λx.λy" "x.λ"))
  (test-equal '("日本" "語") (string-split "日本 語" " ")))

(test-end "srfi 152")
