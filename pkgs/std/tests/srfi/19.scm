(import (rnrs)
  (srfi 64)
  (srfi 19))

(test-begin "srfi 19")

(define (date->list d)
  (list (date-year d) (date-month d) (date-day d) (date-hour d) (date-minute d) (date-second d)
        (date-nanosecond d) (date-zone-offset d)))

(test-group "time objects"
  (let ([t (make-time time-duration 1500000000 0)])
    (test-equal "normalized" '(1 500000000) (list (time-second t) (time-nanosecond t))))
  (test-equal "types" time-utc (time-type (current-time)))
  (test-equal "tai type" time-tai (time-type (current-time time-tai)))
  (test-assert "process time" (time? (current-time time-process)))
  (test-assert "thread time" (time? (current-time time-thread)))
  (test-equal "resolution" 1 (time-resolution))
  (let ([a (make-time time-utc 0 10)] [b (make-time time-utc 500 10)])
    (test-assert "time<?" (time<? a b))
    (test-assert "time<=?" (time<=? a a))
    (test-assert "time>?" (time>? b a))
    (test-assert "time=?" (time=? a (copy-time a)))
    (test-equal "difference" '(time-duration 500 0)
      (let ([d (time-difference b a)]) (list (time-type d) (time-nanosecond d) (time-second d))))
    (test-equal "negative difference" '(-1 999999500)
      (let ([d (time-difference a b)]) (list (time-second d) (time-nanosecond d))))
    (test-equal "add-duration" '(12 500)
      (let ([t (add-duration b (make-time time-duration 0 2))]) (list (time-second t) (time-nanosecond t))))
    (test-equal "subtract-duration" '(9 500)
      (let ([t (subtract-duration b (make-time time-duration 0 1))]) (list (time-second t) (time-nanosecond t))))
    (let ([c (copy-time a)])
      (add-duration! c (make-time time-duration 1 0))
      (test-equal "add-duration!" 1 (time-nanosecond c))
      (set-time-second! c 99)
      (test-equal "setters" 99 (time-second c))))
  (test-assert "different types"
    (guard (e [(assertion-violation? e) #t])
      (time<? (make-time time-utc 0 0) (make-time time-tai 0 0)) #f)))

(test-group "TAI and leap seconds"
  (test-equal "before 1972" 0 (time-second (time-utc->time-tai (make-time time-utc 0 0))))
  (test-equal "1972" (+ 63072000 10) (time-second (time-utc->time-tai (make-time time-utc 0 63072000))))
  (test-equal "2017" (+ 1483228800 37) (time-second (time-utc->time-tai (make-time time-utc 0 1483228800))))
  (test-equal "just before 2017" (+ 1483228799 36) (time-second (time-utc->time-tai (make-time time-utc 0 1483228799))))
  (test-equal "back to utc" 1483228800 (time-second (time-tai->time-utc (make-time time-tai 0 (+ 1483228800 37)))))
  (test-equal "the leap second as a date" '(2016 12 31 23 59 60 0 0)
    (date->list (time-tai->date (make-time time-tai 0 (+ 1483228800 36)) 0)))
  (test-equal "the leap second from a date" (+ 1483228800 36)
    (time-second (date->time-tai (make-date 0 60 59 23 31 12 2016 0))))
  (test-equal "monotonic is tai" (+ 1483228800 37)
    (time-second (time-utc->time-monotonic (make-time time-utc 0 1483228800))))
  (let ([t (make-time time-utc 0 1600000000)])
    (time-utc->time-tai! t)
    (test-equal "in place" time-tai (time-type t))))

(test-group "dates"
  (let ([d (make-date 0 5 4 3 2 1 2006 0)])
    (test-equal "fields" '(2006 1 2 3 4 5 0 0) (date->list d))
    (test-equal "to utc" 1136171045 (time-second (date->time-utc d)))
    (test-equal "back" '(2006 1 2 3 4 5 0 0) (date->list (time-utc->date (date->time-utc d) 0)))
    (test-equal "with an offset" '(2006 1 2 5 4 5 0 7200) (date->list (time-utc->date (date->time-utc d) 7200)))
    (test-equal "week day" 1 (date-week-day d))
    (test-equal "year day" 2 (date-year-day d)))
  (test-equal "week number" 9 (date-week-number (make-date 0 0 0 0 5 3 2024 0) 1))
  (test-equal "week number, Sunday weeks" 0 (date-week-number (make-date 0 0 0 0 1 1 2023 0) 0))
  (test-assert "current-date" (date? (current-date)))
  (test-equal "current-date offset" 3600 (date-zone-offset (current-date 3600))))

(test-group "julian days"
  (test-equal "J2000" 2451545 (date->julian-day (make-date 0 0 0 12 1 1 2000 0)))
  (test-equal "epoch" 4881175/2 (time-utc->julian-day (make-time time-utc 0 0)))
  (test-equal "MJD 0" 0 (date->modified-julian-day (make-date 0 0 0 0 17 11 1858 0)))
  (test-equal "julian day to date" '(2000 1 1 12 0 0 0 0) (date->list (julian-day->date 2451545 0)))
  (test-equal "mjd to time" 0 (time-second (modified-julian-day->time-utc 40587)))
  (test-equal "time-tai julian" 2451545
    (time-tai->julian-day (date->time-tai (make-date 0 0 0 12 1 1 2000 0))))
  (test-assert "current julian day" (> (current-julian-day) 2460000))
  (test-assert "current mjd" (> (current-modified-julian-day) 60000)))

(test-group "date->string"
  (let ([d (make-date 123456789 5 4 15 2 1 2006 -18000)])
    (test-equal "iso" "2006-01-02T15:04:05-0500" (date->string d "~4"))
    (test-equal "~5" "2006-01-02T15:04:05" (date->string d "~5"))
    (test-equal "names" "Mon Monday Jan January" (date->string d "~a ~A ~b ~B"))
    (test-equal "12 hour" "03 PM  3" (date->string d "~I ~p ~l"))
    (test-equal "fraction" "05.123456789" (date->string d "~f"))
    (test-equal "nanoseconds" "123456789" (date->string d "~N"))
    (test-equal "day" "02  2 002" (date->string d "~d ~e ~j"))
    (test-equal "default" "Mon Jan 02 15:04:05-0500 2006" (date->string d))
    (test-equal "tilde" "~" (date->string d "~~"))
    (test-equal "epoch" "1136232245" (date->string d "~s")))
  (test-equal "utc zone" "Z" (date->string (make-date 0 0 0 0 1 1 2000 0) "~z"))
  (test-equal "trimmed fraction" "05.5" (date->string (make-date 500000000 5 0 0 1 1 2000 0) "~f"))
  (test-equal "iso week" "53" (date->string (make-date 0 0 0 0 3 1 2021 0) "~V")))

(test-group "string->date"
  (test-equal "full" '(2006 1 2 3 4 5 0 0)
    (date->list (string->date "2006-01-02 03:04:05Z" "~Y-~m-~d ~H:~M:~S~z")))
  (test-equal "offset" -18000 (date-zone-offset (string->date "2006-01-02 03:04:05-0500" "~Y-~m-~d ~H:~M:~S~z")))
  (test-equal "month names" '(2024 3 5) (let ([d (string->date "5 March 2024 +0000" "~d ~B ~Y ~z")])
                                         (list (date-year d) (date-month d) (date-day d))))
  (test-equal "abbreviations" 2 (date-month (string->date "Tue Feb 06 2024 +0000" "~a ~b ~d ~Y ~z")))
  (test-equal "fraction" 250000000 (date-nanosecond (string->date "2024-01-01 00:00:01.25 +0000" "~Y-~m-~d ~H:~M:~f ~z")))
  (test-assert "mismatch" (guard (e [(error? e) #t]) (string->date "2024/01/01" "~Y-~m-~d") #f)))

(test-end "srfi 19")
