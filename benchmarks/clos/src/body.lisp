;;;; CLOS benchmark body (portable Common Lisp). Mirrors body.scm one-to-one,
;;;; including checksums. run.py compiles this file with COMPILE-FILE.

(declaim (optimize (speed 1) (safety 1) (debug 0)))

(defun m (x) (mod x 1000003))
(defun mix (a b) (mod (+ (* a 31) b) 1000003))

(defvar *seed* 12345)
(defun rand! (n)
  (setf *seed* (mod (* *seed* 48271) 2147483647))
  (mod *seed* n))

;;; 1. slot reads
(defclass vec3 ()
  ((x :initarg :x :initform 0 :accessor vec-x)
   (y :initarg :y :initform 0 :accessor vec-y)
   (z :initarg :z :initform 0 :accessor vec-z)))

(defun make-vecs (n)
  (let ((v (make-array n)))
    (dotimes (i n v)
      (setf (aref v i) (make-instance 'vec3 :x i :y (* 2 i) :z (* 3 i))))))

(defvar *vecs* (make-vecs 1024))

(defun bench-accessor-read ()
  (let ((sum 0) (vecs *vecs*))
    (dotimes (r 6000)
      (dotimes (i 1024)
        (let ((v (aref vecs i)))
          (incf sum (+ (vec-x v) (vec-y v) (vec-z v))))))
    (m sum)))

(defun bench-slot-ref-read ()
  (let ((sum 0) (vecs *vecs*))
    (dotimes (r 3000)
      (dotimes (i 1024)
        (let ((v (aref vecs i)))
          (incf sum (+ (slot-value v 'x) (slot-value v 'y) (slot-value v 'z))))))
    (m sum)))

;;; 2. slot writes
(defclass particle ()
  ((x :initarg :x :initform 0 :accessor p-x)
   (y :initarg :y :initform 0 :accessor p-y)
   (vx :initarg :vx :initform 0 :accessor p-vx)
   (vy :initarg :vy :initform 0 :accessor p-vy)))

(defun step-particle! (p)
  (let ((x (+ (p-x p) (p-vx p)))
        (y (+ (p-y p) (p-vy p))))
    (when (or (< x 0) (> x 10000)) (setf (slot-value p 'vx) (- (p-vx p))))
    (when (or (< y 0) (> y 10000)) (setf (slot-value p 'vy) (- (p-vy p))))
    (setf (slot-value p 'x) x)
    (setf (slot-value p 'y) y)))

(defun bench-particles ()
  (setf *seed* 777)
  (let ((ps (make-array 512)))
    (dotimes (i 512)
      (let* ((x (rand! 10000)) (y (rand! 10000))
             (vx (- (rand! 41) 20)) (vy (- (rand! 41) 20)))
        (setf (aref ps i) (make-instance 'particle :x x :y y :vx vx :vy vy))))
    (dotimes (tt 4000)
      (dotimes (i 512) (step-particle! (aref ps i))))
    (let ((s 0))
      (dotimes (i 512) (incf s (+ (p-x (aref ps i)) (* 3 (p-y (aref ps i))))))
      (m s))))

;;; 3. single dispatch
(defclass shape () ((name :initform 0)))
(defclass circle (shape) ((r :initarg :r :accessor circle-r)))
(defclass rect (shape) ((w :initarg :w :accessor rect-w) (h :initarg :h :accessor rect-h)))
(defclass square (rect) ())
(defclass tri (shape) ((b :initarg :b :accessor tri-b) (h :initarg :h :accessor tri-h)))

(defgeneric area (s))
(defgeneric perimeter (s))
(defmethod area ((s circle)) (* 3 (circle-r s) (circle-r s)))
(defmethod area ((s rect)) (* (rect-w s) (rect-h s)))
(defmethod area ((s tri)) (floor (* (tri-b s) (tri-h s)) 2))
(defmethod perimeter ((s circle)) (* 6 (circle-r s)))
(defmethod perimeter ((s rect)) (* 2 (+ (rect-w s) (rect-h s))))
(defmethod perimeter ((s square)) (* 4 (rect-w s)))
(defmethod perimeter ((s tri)) (+ (tri-b s) (tri-h s) (tri-b s)))

(defun make-shapes (n)
  (setf *seed* 99)
  (let ((v (make-array n)))
    (dotimes (i n v)
      (setf (aref v i)
            (case (mod i 4)
              (0 (make-instance 'circle :r (+ 1 (rand! 50))))
              (1 (let* ((w (+ 1 (rand! 50))) (h (+ 1 (rand! 50))))
                   (make-instance 'rect :w w :h h)))
              (2 (make-instance 'square :w (+ 1 (rand! 50)) :h 1))
              (t (let* ((b (+ 1 (rand! 50))) (h (+ 1 (rand! 50))))
                   (make-instance 'tri :b b :h h))))))))

(defvar *shapes* (make-shapes 1024))

(defun bench-shapes ()
  (let ((sum 0) (shapes *shapes*))
    (dotimes (r 3000)
      (dotimes (i 1024)
        (let ((sh (aref shapes i)))
          (incf sum (+ (area sh) (perimeter sh))))))
    (m sum)))

;;; 4. multi-methods
(defclass entity () ((hp :initarg :hp :initform 1 :accessor hp)))
(defclass asteroid (entity) ())
(defclass ship (entity) ())
(defclass bullet (entity) ())
(defclass shield (entity) ())

(defgeneric collide (a b))
(defmethod collide ((a entity) (b entity)) 1)
(defmethod collide ((a asteroid) (b asteroid)) 2)
(defmethod collide ((a asteroid) (b ship)) (+ 3 (hp a)))
(defmethod collide ((a ship) (b asteroid)) (+ 5 (hp b)))
(defmethod collide ((a bullet) (b asteroid)) 7)
(defmethod collide ((a bullet) (b ship)) 11)
(defmethod collide ((a ship) (b shield)) 13)
(defmethod collide ((a shield) (b entity)) (+ 17 (hp b)))
(defmethod collide ((a entity) (b bullet)) (+ 19 (hp a)))

(defun make-entities (n)
  (let ((v (make-array n)))
    (dotimes (i n v)
      (setf (aref v i)
            (case (mod (* i 7) 4)
              (0 (make-instance 'asteroid :hp (+ 1 (mod i 5))))
              (1 (make-instance 'ship :hp (+ 1 (mod i 3))))
              (2 (make-instance 'bullet))
              (t (make-instance 'shield :hp (+ 1 (mod i 7)))))))))

(defvar *entities* (make-entities 1024))

(defun bench-collide ()
  (let ((sum 0) (es *entities*))
    (dotimes (r 3000)
      (dotimes (i 1024)
        (incf sum (collide (aref es i) (aref es (mod (+ i r 1) 1024))))))
    (m sum)))

;;; 5. next-method chains
(defclass item () ((price :initarg :price :accessor item-price)))
(defclass taxed (item) ())
(defclass discounted (taxed) ((pct :initarg :pct :initform 10 :accessor item-pct)))
(defclass premium (discounted) ())

(defgeneric cost (o qty))
(defmethod cost ((o item) qty) (* qty (item-price o)))
(defmethod cost ((o taxed) qty) (let ((c (call-next-method))) (+ c (floor c 10))))
(defmethod cost ((o discounted) qty)
  (let ((c (call-next-method))) (- c (floor (* c (item-pct o)) 100))))
(defmethod cost ((o premium) qty) (+ 5 (call-next-method)))

(defvar *items*
  (let ((v (make-array 1024)))
    (dotimes (i 1024 v)
      (setf (aref v i)
            (case (mod i 4)
              (0 (make-instance 'item :price (+ 10 i)))
              (1 (make-instance 'taxed :price (+ 10 i)))
              (2 (make-instance 'discounted :price (+ 10 i) :pct (+ 5 (mod i 20))))
              (t (make-instance 'premium :price (+ 10 i) :pct 15)))))))

(defun bench-next-method ()
  (let ((sum 0) (items *items*))
    (dotimes (r 3000)
      (dotimes (i 1024)
        (incf sum (cost (aref items i) (+ 1 (mod r 3))))))
    (m sum)))

;;; 6. allocation
(defclass tnode ()
  ((left :initarg :left :initform nil :accessor tnode-left)
   (right :initarg :right :initform nil :accessor tnode-right)
   (val :initarg :val :initform 0 :accessor tnode-val)))

(defun build-tree (d)
  (if (= d 0)
      (make-instance 'tnode :val 1)
      (let* ((l (build-tree (- d 1))) (r (build-tree (- d 1))))
        (make-instance 'tnode :left l :right r :val d))))

(defgeneric tree-sum (n))
(defmethod tree-sum ((n null)) 0)
(defmethod tree-sum ((n tnode))
  (+ (tnode-val n) (tree-sum (tnode-left n)) (tree-sum (tnode-right n))))

(defun bench-alloc ()
  (let ((s 0))
    (dotimes (i 60) (incf s (tree-sum (build-tree 14))))
    (m s)))

;;; 7. AST interpreter
(defclass node () ())
(defclass lit (node) ((val :initarg :val :accessor lit-val)))
(defclass ref (node) ((idx :initarg :idx :accessor ref-idx)))
(defclass setl (node)
  ((idx :initarg :idx :accessor setl-idx) (expr :initarg :expr :accessor setl-expr)))
(defclass binop (node)
  ((a :initarg :a :accessor bin-a) (b :initarg :b :accessor bin-b)))
(defclass add (binop) ())
(defclass sub (binop) ())
(defclass mul (binop) ())
(defclass lt (binop) ())
(defclass seq (binop) ())
(defclass iff (node)
  ((c :initarg :c :accessor iff-c) (tt :initarg :t :accessor iff-t) (e :initarg :e :accessor iff-e)))
(defclass while-node (node)
  ((c :initarg :c :accessor while-c) (body :initarg :body :accessor while-body)))
(defclass fn ()
  ((nlocals :initarg :nlocals :accessor fn-nlocals) (body :initform nil :accessor fn-body)))
(defclass call (node)
  ((fn :initarg :fn :initform nil :accessor call-fn) (args :initarg :args :accessor call-args)))

(defgeneric ev (n fr))
(defmethod ev ((n lit) fr) (lit-val n))
(defmethod ev ((n ref) fr) (svref fr (ref-idx n)))
(defmethod ev ((n setl) fr)
  (let ((v (ev (setl-expr n) fr))) (setf (svref fr (setl-idx n)) v) v))
(defmethod ev ((n add) fr) (m (+ (ev (bin-a n) fr) (ev (bin-b n) fr))))
(defmethod ev ((n sub) fr) (m (- (ev (bin-a n) fr) (ev (bin-b n) fr))))
(defmethod ev ((n mul) fr) (m (* (ev (bin-a n) fr) (ev (bin-b n) fr))))
(defmethod ev ((n lt) fr) (if (< (ev (bin-a n) fr) (ev (bin-b n) fr)) 1 0))
(defmethod ev ((n seq) fr) (ev (bin-a n) fr) (ev (bin-b n) fr))
(defmethod ev ((n iff) fr)
  (if (= 0 (ev (iff-c n) fr)) (ev (iff-e n) fr) (ev (iff-t n) fr)))
(defmethod ev ((n while-node) fr)
  (loop (when (= 0 (ev (while-c n) fr)) (return 0))
        (ev (while-body n) fr)))
(defmethod ev ((n call) fr)
  (let* ((f (call-fn n))
         (args (call-args n))
         (new (make-array (fn-nlocals f) :initial-element 0)))
    (dotimes (i (length args))
      (setf (svref new i) (ev (svref args i) fr)))
    (ev (fn-body f) new)))

(defun lit* (v) (make-instance 'lit :val v))
(defun ref* (i) (make-instance 'ref :idx i))

(defun make-fib ()
  (let* ((f (make-instance 'fn :nlocals 1)))
    (flet ((call (k)
             (make-instance 'call :fn f
                            :args (vector (make-instance 'sub :a (ref* 0) :b (lit* k))))))
      (setf (fn-body f)
            (make-instance 'iff
                           :c (make-instance 'lt :a (ref* 0) :b (lit* 2))
                           :t (ref* 0)
                           :e (make-instance 'add :a (call 1) :b (call 2)))))
    f))

(defun make-sum-loop (n)
  (let ((f (make-instance 'fn :nlocals 3)))
    (setf (fn-body f)
          (make-instance
           'seq
           :a (make-instance
               'while-node
               :c (make-instance 'lt :a (ref* 0) :b (lit* n))
               :body (make-instance
                      'seq
                      :a (make-instance
                          'setl :idx 1
                          :expr (make-instance 'add :a (ref* 1)
                                               :b (make-instance 'mul :a (ref* 0) :b (ref* 0))))
                      :b (make-instance
                          'setl :idx 0
                          :expr (make-instance 'add :a (ref* 0) :b (lit* 1)))))
           :b (ref* 1)))
    f))

(defvar *fib-fn* (make-fib))
(defvar *loop-fn* (make-sum-loop 800000))

(defun bench-ast-eval ()
  (mix (ev (fn-body *fib-fn*) (vector 27))
       (ev (fn-body *loop-fn*) (make-array 3 :initial-element 0))))

;;; 8. AST optimiser
(defun gen (d)
  (if (= d 0)
      (if (< (rand! 10) 6) (lit* (rand! 4)) (ref* (rand! 3)))
      (let* ((a (gen (- d 1))) (b (gen (- d 1))))
        (case (rand! 3)
          (0 (make-instance 'add :a a :b b))
          (1 (make-instance 'sub :a a :b b))
          (t (make-instance 'mul :a a :b b))))))

(defgeneric mk-add (a b))
(defgeneric mk-sub (a b))
(defgeneric mk-mul (a b))
(defmethod mk-add ((a lit) (b lit)) (lit* (m (+ (lit-val a) (lit-val b)))))
(defmethod mk-add ((a lit) (b node))
  (if (= 0 (lit-val a)) b (make-instance 'add :a a :b b)))
(defmethod mk-add ((a node) (b lit))
  (if (= 0 (lit-val b)) a (make-instance 'add :a a :b b)))
(defmethod mk-add ((a node) (b node)) (make-instance 'add :a a :b b))
(defmethod mk-sub ((a lit) (b lit)) (lit* (m (- (lit-val a) (lit-val b)))))
(defmethod mk-sub ((a node) (b lit))
  (if (= 0 (lit-val b)) a (make-instance 'sub :a a :b b)))
(defmethod mk-sub ((a node) (b node)) (make-instance 'sub :a a :b b))
(defmethod mk-mul ((a lit) (b lit)) (lit* (m (* (lit-val a) (lit-val b)))))
(defmethod mk-mul ((a lit) (b node))
  (case (lit-val a) (0 a) (1 b) (t (make-instance 'mul :a a :b b))))
(defmethod mk-mul ((a node) (b lit))
  (case (lit-val b) (0 b) (1 a) (t (make-instance 'mul :a a :b b))))
(defmethod mk-mul ((a node) (b node)) (make-instance 'mul :a a :b b))

(defgeneric simplify (n))
(defmethod simplify ((n lit)) n)
(defmethod simplify ((n ref)) n)
(defmethod simplify ((n add)) (mk-add (simplify (bin-a n)) (simplify (bin-b n))))
(defmethod simplify ((n sub)) (mk-sub (simplify (bin-a n)) (simplify (bin-b n))))
(defmethod simplify ((n mul)) (mk-mul (simplify (bin-a n)) (simplify (bin-b n))))

(defgeneric size (n))
(defmethod size ((n lit)) 1)
(defmethod size ((n ref)) 1)
(defmethod size ((n binop)) (+ 1 (size (bin-a n)) (size (bin-b n))))

(defun bench-ast-simplify ()
  (setf *seed* 4242)
  (let ((fr (vector 3 5 7)) (s 0))
    (dotimes (i 100 s)
      (let* ((tr (gen 11))
             (u (simplify tr))
             (v1 (ev tr fr))
             (v2 (ev u fr)))
        (setf s (mix (mix (mix s (size tr)) (size u)) (mix v1 (if (= v1 v2) 0 999))))))))

;;; harness
(defparameter *warmup* 2)
(defparameter *timed* 5)

(defun now ()
  (/ (float (get-internal-real-time) 1d0) internal-time-units-per-second))

(defun run-bench (name thunk)
  (let ((result nil) (times '()))
    (dotimes (i *warmup*) (setf result (funcall thunk)))
    (dotimes (i *timed*)
      (let* ((t0 (now)) (r (funcall thunk)) (t1 (now)))
        (setf result r)
        (push (- t1 t0) times)))
    (let ((sorted (sort times #'<)))
      (format t "RESULT ~a ~,6f ~a~%" name (nth (floor (length sorted) 2) sorted) result)
      (finish-output))))

(defun main ()
  (progn
    (flet ((bench (name thunk) (run-bench name thunk)))
      (bench "accessor-read" #'bench-accessor-read)
      (bench "slot-ref-read" #'bench-slot-ref-read)
      (bench "particles" #'bench-particles)
      (bench "shapes" #'bench-shapes)
      (bench "collide" #'bench-collide)
      (bench "next-method" #'bench-next-method)
      (bench "alloc-trees" #'bench-alloc)
      (bench "ast-eval" #'bench-ast-eval)
      (bench "ast-simplify" #'bench-ast-simplify))))
