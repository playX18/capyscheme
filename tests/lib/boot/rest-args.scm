;; Variadic procedures at all tiers: scalar-mode and vector-mode entries, inlined
;; variadic callees, deopts, and apply with long argument lists.
(import (scheme base) (scheme write) (scheme cxr) (srfi 64))
(test-begin "rest args")
;; K=1,2,3 scalar candidates and K=4 (vector mode); each also reports the whole rest list through length.
(define (k1 a . r) (if (null? r) (list a) (list a (car r))))
(define (k2 a . r) (cond ((null? r) (list a)) ((null? (cdr r)) (list a (car r))) (else (list a (car r) (cadr r)))))
(define (k3 a . r) (cond ((null? r) 0) ((null? (cdr r)) (car r)) ((null? (cddr r)) (+ (car r) (cadr r))) (else (+ (car r) (cadr r) (caddr r) (length r)))))
(define (k4 a . r) (if (and (pair? r) (pair? (cdr r)) (pair? (cddr r)) (pair? (cdddr r))) (cadddr r) 'short))
(define (unsafe-first . r) (car r))
(define (opt2 x . r) (let ((y (if (pair? r) (car r) 10)) (z (if (and (pair? r) (pair? (cdr r))) (cadr r) 20))) (list x y z)))
(define (only-len . r) (length r))
(define (caller-mix x) (list (opt2 x) (opt2 x 1) (opt2 x 1 2) (opt2 x 1 2 3 4 5)))
(define (check name got want) (test-equal name want got))
(define (round1 i)
  (check "k1-0" (k1 1) '(1)) (check "k1-1" (k1 1 2) '(1 2)) (check "k1-3" (k1 1 2 3 4) '(1 2))
  (check "k2-0" (k2 1) '(1)) (check "k2-1" (k2 1 2) '(1 2)) (check "k2-2" (k2 1 2 3) '(1 2 3)) (check "k2-5" (k2 1 2 3 4 5 6) '(1 2 3))
  (check "k3-0" (k3 1) 0) (check "k3-1" (k3 1 5) 5) (check "k3-2" (k3 1 5 6) 11) (check "k3-3" (k3 1 5 6 7) 21) (check "k3-6" (k3 1 5 6 7 8 9 10) 24)
  (check "k4" (k4 1 2 3 4 5) 5) (check "k4s" (k4 1 2) 'short)
  (check "only-len" (only-len 1 2 3 4 5 6 7) 7)
  (check "mix" (caller-mix i) (list (list i 10 20) (list i 1 20) (list i 1 2) (list i 1 2)))
  (check "apply" (apply opt2 (list i 7 8 9)) (list i 7 8))
  (check "apply-big" (apply only-len (let loop ((j 0) (a '())) (if (= j 300) a (loop (+ j 1) (cons j a))))) 300)
  (check "gc" (let loop ((j 0) (acc 0)) (if (= j 40) acc (loop (+ j 1) (+ acc (length (k1 j j)))))) 80))
(let loop ((i 0)) (when (< i 3000) (round1 i) (loop (+ i 1))))
;; after warmup: errors and deopt paths
(check "car-empty" (guard (e (#t 'err)) (unsafe-first)) 'err)
(check "car-ok" (unsafe-first 9 8) 9)
(check "k1-deopt-float" (k1 1.5 2.5) '(1.5 2.5))
(check "k3-deopt-big" (k3 1 100000000000000000000 1) 100000000000000000001)
(check "k3-err" (guard (e (#t 'err)) (k3 1 'a 'b)) 'err)
(check "opt2-after" (opt2 'x "s" #\c) '(x "s" #\c))
(test-end "rest args")
